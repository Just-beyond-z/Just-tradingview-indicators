//@version=6
indicator("Fractal Model (Just)", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_bars_back=5000)

//─────────────────────
// HTF Candle Types + Settings
//─────────────────────
type Candle
	float o
	float c
	float h
	float l
	int o_idx
	int c_idx
	int h_idx
	int l_idx
	int o_time
	box body
	line wick_up
	line wick_down
    line swing_high_line
    line swing_low_line
    line div_high_line
    line div_low_line
    line eq_line
    label dow_label
    string dow

type CandleSettings
	bool show
	string htf

type Trace
	line o

type Imbalance
	box b

type Settings
	int max_sets
	color bull_body
	color bear_body
	color border
	int offset
	int buffer
	int htf_buffer
	int width
    string label_position
    string label_alignment
	bool htf_label_show
	color htf_label_color
	string htf_label_size
	bool htf_timer_show
	color htf_timer_color
	string htf_timer_size
    bool trace_show
	color trace_o_color
	string trace_o_style
	int trace_o_size
    bool daily_name
    color dow_color
    string dow_size
    bool fvg_show
    color fvg_color
    bool vi_show
    color vi_color

type CandleSet
	array<Candle> candles
	array<Imbalance> imbalances
	CandleSettings settings
	label tfNameTop
    label tfNameBottom
	label tfTimerTop
    label tfTimerBottom

Settings settings = Settings.new()

