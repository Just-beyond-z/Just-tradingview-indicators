// Check if current chart symbol matches any from symbol
getCurrentPairIndex() =>
    current_symbol = syminfo.tickerid
    if str.contains(current_symbol, from_pair1) or str.contains(from_pair1, current_symbol)
        1
    else if str.contains(current_symbol, from_pair2) or str.contains(from_pair2, current_symbol)
        2
    else if str.contains(current_symbol, from_pair3) or str.contains(from_pair3, current_symbol)
        3
    else if str.contains(current_symbol, from_pair4) or str.contains(from_pair4, current_symbol)
        4
    else if str.contains(current_symbol, from_pair5) or str.contains(from_pair5, current_symbol)
        5
    else if str.contains(current_symbol, from_pair6) or str.contains(from_pair6, current_symbol)
        6
    else
        0

// Get symbol pairs based on index
getSymbolPairs(index) =>
    if index == 1
        [from_pair1, to_pair1a, to_pair1b, enable_to_pair1b]
    else if index == 2
        [from_pair2, to_pair2a, to_pair2b, enable_to_pair2b]
    else if index == 3
        [from_pair3, to_pair3a, to_pair3b, enable_to_pair3b]
    else if index == 4
        [from_pair4, to_pair4a, to_pair4b, enable_to_pair4b]
    else if index == 5
        [from_pair5, to_pair5a, to_pair5b, enable_to_pair5b]
    else if index == 6
        [from_pair6, to_pair6a, to_pair6b, enable_to_pair6b]
    else
        [na, na, na, false]

// Function to detect divergence between two price arrays
detectDivergence(prev_price1, curr_price1, prev_price2, curr_price2, is_high) =>
    if is_high
        // High divergence: one makes higher high, other makes lower high
        curr_price1 > prev_price1 and curr_price2 < prev_price2 or curr_price1 < prev_price1 and curr_price2 > prev_price2
    else // Low divergence: one makes lower low, other makes higher low
        curr_price1 < prev_price1 and curr_price2 > prev_price2 or curr_price1 > prev_price1 and curr_price2 < prev_price2

// Convert swing settings
confirmedSweepStyle_value = confirmed_sweep_style == "Solid" ? line.style_solid :confirmed_sweep_style == "Dashed" ? line.style_dashed : line.style_dotted
potentialSweepStyle_value = potential_sweep_style == "Solid" ? line.style_solid : potential_sweep_style == "Dashed" ? line.style_dashed : line.style_dotted
smt_line_style_value = smt_line_style == "Solid" ? line.style_solid : smt_line_style == "Dashed" ? line.style_dashed : line.style_dotted
trace_o_line_style_value = settings.trace_o_style == "Solid" ? line.style_solid : settings.trace_o_style == "Dashed" ? line.style_dashed : line.style_dotted
eq_line_style_value = eq_line_style_input == "Solid" ? line.style_solid : eq_line_style_input == "Dashed" ? line.style_dashed : line.style_dotted
fmProjStyle_value = line.style_solid 
