// ── FVG Variables ─────────────────────────────────────────
color color_transparent = #ffffff00

ScriptHelper helper = ScriptHelper.new()

var FvgStructure FVG_1 = FvgStructure.new()
var FvgStructure FVG_2 = FvgStructure.new()
var FvgStructure FVG_3 = FvgStructure.new()
var FvgStructure FVG_4 = FvgStructure.new()

var array<FvgZone> FVGs_1 = array.new<FvgZone>()
var array<FvgZone> FVGs_2 = array.new<FvgZone>()
var array<FvgZone> FVGs_3 = array.new<FvgZone>()
var array<FvgZone> FVGs_4 = array.new<FvgZone>()

FVG_1.imbalance := FVGs_1
FVG_1.settings := HTF_1_FVG_Settings
FVG_2.imbalance := FVGs_2
FVG_2.settings := HTF_2_FVG_Settings
FVG_3.imbalance := FVGs_3
FVG_3.settings := HTF_3_FVG_Settings
FVG_4.imbalance := FVGs_4
FVG_4.settings := HTF_4_FVG_Settings

//Used internally for padding

var float daily = 0
var float monthly = 0

int cspacer = timeframe.in_seconds() * 1000

var array<float> median = array.new_float()
length = 500
median.unshift(high - low)
if median.size() > length
    median.pop()
float spacing = ta.sma(ta.sma(median.median(), length), length) * labelfactor

// ── FVG Methods ─────────────────────────────────────────
method LineStyle(ScriptHelper helper, string style) =>
    helper.name := style

    out = switch style
        '----' => line.style_dashed
        '····' => line.style_dotted
        => line.style_solid

    out

method Text(ScriptHelper helper, string htf, string direction, string level, bool truncate) =>
    helper.name := htf

    string formatted = ''

    seconds = timeframe.in_seconds(htf)
    if seconds < 60
        formatted := str.tostring(seconds) + 's'
        formatted
    else if seconds / 60 < 60
        formatted := str.tostring(seconds / 60) + 'm'
        formatted
    else if seconds / 60 / 60 < 24
        formatted := str.tostring(seconds / 60 / 60) + 'H'
        formatted
    else
        formatted := htf
        formatted

    formatted + ' ' + direction + 'fvg'

method Validtimeframe(ScriptHelper helper, tf) =>
    bool valid = true

    helper.name := tf
    n1 = timeframe.in_seconds()
    n2 = timeframe.in_seconds(tf)

    if n1 > n2
        valid := false
    valid

method ProximityRange(ScriptHelper helper, tf) =>
    helper.name := tf
    float range_high = 0
    float range_low = 0
    if timeframe.isseconds or timeframe.isminutes
        range_high := close + daily / proximity
        range_low := close - daily / proximity
        range_low
    if timeframe.isdaily
        range_high := close + monthly * 3
        range_low := close - monthly * 3
        range_low
    if timeframe.isweekly
        range_high := close + monthly * 12
        range_low := close - monthly * 12
        range_low
    [range_low, range_high]

method HTFEnabled(ScriptHelper helper) =>
    helper.name := 'HTFEnabled'
    int enabled = 0
    enabled := enabled + (FVG_1.settings.show and helper.Validtimeframe(FVG_1.settings.htf) ? 1 : 0)
    enabled := enabled + (FVG_2.settings.show and helper.Validtimeframe(FVG_2.settings.htf) ? 1 : 0)
    enabled := enabled + (FVG_3.settings.show and helper.Validtimeframe(FVG_3.settings.htf) ? 1 : 0)
    enabled := enabled + (FVG_4.settings.show and helper.Validtimeframe(FVG_4.settings.htf) ? 1 : 0)

find_low_bar_time(float price, int start, int default, bool inverse) =>
    int loc = default
    int x = inverse ? 0 : (time - start) / cspacer
    int y = inverse ? (time - start) / cspacer : 0

    if x < 5000 and y < 5000
        for i = x to y by 1
            if low[i] == price
                loc := time[i]
                break
    loc

find_high_bar_time(float price, int start, int default, bool inverse) =>
    int loc = default
    int x = inverse ? 0 : (time - start) / cspacer
    int y = inverse ? (time - start) / cspacer : 0

    if x < 5000 and y < 5000
        for i = x to y by 1
            if high[i] == price
                loc := time[i]
                break
    loc

refresh_visible_timeframes() =>
    int step = 1

    FVG_1.step := 1
    for t in FVG_1.imbalance
        if not na(t.box2)
            FVG_1.step := step
            step := step + 1
            break

    FVG_2.step := 1
    for t in FVG_2.imbalance
        if not na(t.box2)
            FVG_2.step := step
            step := step + 1
            break

    FVG_3.step := 1
    for t in FVG_3.imbalance
        if not na(t.box2)
            FVG_3.step := step
            step := step + 1
            break

    FVG_4.step := 1
    for t in FVG_4.imbalance
        if not na(t.box2)
            FVG_4.step := step
            step := step + 1
            break

method clear(FvgZone imb) =>
    if not na(imb.box2)
        line.delete(imb.box2.open)
        line.delete(imb.box2.close)
        line.delete(imb.box2.ce)
        linefill.delete(imb.box2.fill)
        label.delete(imb.box2.label_ce)
        imb.box2 := na
        imb.box2


// AddZone is used to display and manage FVG-related boxes
method AddZone(FvgStructure IS, FvgZone imb, int step) =>
    bool visible = true
    if IS.settings.show
        int v_buffer = time + (time - time[1]) * (extend + 1 + buffer * (step - 1))

        if imb.mitigated and not mitigated_show
            if not na(imb.box2)
                visible := false
                visible
            imb.clear()

        if na(imb.box2)
            color c = imb.isbullish ? IS.settings.color_bull : IS.settings.color_bear

            imb.box2 := ZoneBox.new()
            imb.box2.open := line.new(imb.open_time, imb.open, v_buffer, imb.open, xloc = xloc.bar_time, style = line.style_dotted, color = color_transparent, width = 1)
            imb.box2.close := line.new(imb.close_time, imb.close, v_buffer, imb.close, xloc = xloc.bar_time, style = line.style_dotted, color = color_transparent, width = 1)
            
            imb.box2.fill := linefill.new(imb.box2.open, imb.box2.close, color.new(c, fill_percent))
            imb.box2.fill

            if CE_show
                imb.box2.ce := line.new((imb.open_time + imb.close_time) / 2, imb.middle, v_buffer, imb.middle, xloc = xloc.bar_time, style = helper.LineStyle(CE_style), color = CE_color, width = 1)
                imb.box2.ce
            if math.abs(imb.open - imb.close) >= spacing
                imb.box2.label_ce := label.new(v_buffer, imb.middle, text = helper.Text(IS.settings.htf, imb.isbullish ? '+' : '-', 'ce', false), xloc = xloc.bar_time, textcolor = fvg_label_color, style = label.style_label_left, color = color_transparent, size = size.tiny)
                imb.box2.label_ce
            else
                imb.box2.label_ce := label.new(v_buffer, imb.middle, text = helper.Text(IS.settings.htf, imb.isbullish ? '+' : '-', '', false), xloc = xloc.bar_time, textcolor = fvg_label_color, style = label.style_label_left, color = color_transparent, size = size.tiny)
                imb.box2.label_ce
    visible

method updateZone(FvgStructure IS) =>
    if barstate.islast
        refresh_visible_timeframes()
        int level = IS.step
        for imb in IS.imbalance
            if not na(imb.box2)
                int v_buffer = 0
                if imb.mitigated
                    v_buffer := imb.close_time + cspacer * mitigated_extend
                    line.set_color(imb.box2.ce, imb.isbullish ? mitigated_color_bull : mitigated_color_bear)
                    linefill.set_color(imb.box2.fill, color.new(imb.isbullish ? mitigated_color_bull : mitigated_color_bear, fill_percent))
                else
                    if extendby == 'When in Range'
                        float atrlength = ta.atr(14) * atrfactor
                        if math.max(imb.open, imb.close) > close - atrlength and math.min(imb.open, imb.close) < close + atrlength
                            v_buffer := time + cspacer * (extend + 1 + (level - 1) * buffer)
                            v_buffer
                        else
                            v_buffer := imb.close_time + cspacer * (extend + 1)
                            v_buffer
                    else
                        v_buffer := time + cspacer * (extend + 1 + (level - 1) * buffer)
                        v_buffer

                line.set_x2(imb.box2.open, v_buffer)
                line.set_x2(imb.box2.close, v_buffer)
                label.set_x(imb.box2.label_ce, v_buffer)

                if CE_show
                    line.set_x2(imb.box2.ce, v_buffer)

// AddImbalance adds a newly discovered FVG zone to the active list
method AddImbalance(FvgStructure IS, float o, float c, int o_time, int c_time) =>
    FvgZone imb = FvgZone.new()
    imb.open_time := o < c ? find_high_bar_time(o, o_time, o_time, false) : find_low_bar_time(o, o_time, o_time, false) // o_time
    imb.close_time := o < c ? find_low_bar_time(c, o_time, c_time, true) : find_high_bar_time(c, o_time, c_time, true) // c_time
    imb.open := o
    imb.middle := (o + c) / 2
    imb.close := c
    imb.isbullish := o < c
    IS.imbalance.unshift(imb)

    if IS.imbalance.size() > IS.settings.max_count
        temp = IS.imbalance.pop()
        temp.clear()
    IS

// CheckMitigated checks whether the FVG has been filled based on the active settings
method CheckMitigated(FvgStructure IS, o, h, l, c, bool isHTF) =>
    if IS.imbalance.size() > 0
        for i = IS.imbalance.size() - 1 to 0 by 1
            imb = IS.imbalance.get(i)

            if not imb.mitigated
                switch mitigated_type
                    'None' => 
                	    imb.mitigated := false
                	    imb.mitigated
                    'Touched' => 
                	    imb.mitigated := (imb.open <= imb.close ? low < imb.close : high > imb.close)
                	    imb.mitigated
                    'Wick filled' => 
                	    imb.mitigated := (imb.open <= imb.close ? low <= imb.open : high >= imb.open)
                	    imb.mitigated
                    'Body filled' => 
                	    imb.mitigated := isHTF and (imb.open < imb.close ? math.min(o, c) <= imb.open : math.max(o, c) >= imb.open)
                	    imb.mitigated
                    'Wick filled half' => 
                	    imb.mitigated := imb.open <= imb.close ? low <= imb.middle : high >= imb.middle
                	    imb.mitigated
                    'Body filled half' => 
                	    imb.mitigated := isHTF and (imb.open <= imb.close ? math.min(o, c) <= imb.middle : math.max(o, c) >= imb.middle)
                	    imb.mitigated
                if imb.mitigated
                    if not mitigated_show
                        imb.clear()
                        IS.imbalance.remove(i)
                    else
                        imb.mitigated_time := time
                        imb.mitigated_time
                    IS.updateZone()
    IS

method ProximityTest(FvgStructure IS) =>
    if IS.imbalance.size() > 0
        [rl, rh] = helper.ProximityRange(IS.settings.htf)
        for i = 0 to IS.imbalance.size() - 1 by 1
            imb = IS.imbalance.get(i)
            if (math.max(imb.open, imb.close) > rl and math.min(imb.open, imb.close) < rh) or not useProximity
                IS.AddZone(imb, IS.order)
            else
                imb.clear()
    IS
    // FindImbalance looks for imbalances and, if found, adds it to the list
method FindImbalance(FvgStructure IS, o, h, l, c, t, o1, h1, l1, c1, t1, o2, h2, l2, c2, t2) =>
    if IS.settings.show
        if h < l2 and h > l1 and l2 < h1
            IS.AddImbalance(l2, h, t2, t)
        if l > h2 and l < h1 and h2 > l1
            IS.AddImbalance(h2, l, t2, t)
    IS

method Process(FvgStructure IS, float o, float h, float l, float c, int t, float o1, float h1, float l1, float c1, int t1, float o2, float h2, float l2, float c2, int t2) =>
    bool show = false

    if IS.settings.show
        if helper.Validtimeframe(IS.settings.htf)
            IS.FindImbalance(o, h, l, c, t, o1, h1, l1, c1, t1, o2, h2, l2, c2, t2)

getHTF(string htf, int i) =>
    [open[i], high[i], low[i], close[i], time[i]]

method check(FvgStructure IS, string htf) =>
    bool newCandle = bool(ta.change(time(htf, "america/New_York")))
    if newCandle
        int inc = 1 //barstate.isrealtime ? 1 : 0
        [o, h, l, c, t]        = request.security(syminfo.tickerid, htf, getHTF(htf, inc), lookahead = barmerge.lookahead_on)
        [o1, h1, l1, c1, t1]   = request.security(syminfo.tickerid, htf, getHTF(htf, inc+1), lookahead = barmerge.lookahead_on)
        [o2, h2, l2, c2, t2]   = request.security(syminfo.tickerid, htf, getHTF(htf, inc+2), lookahead = barmerge.lookahead_on)
        if not na(o)
            IS.Process(o, h, l, c, t, o1, h1, l1, c1, t1, o2, h2, l2, c2, t2)
            IS.ProximityTest()
            IS.CheckMitigated(o, h, l, c, bool(ta.change(time(htf, "america/New_York"))))

    IS.CheckMitigated(open, high, low, close, newCandle)

    IS.updateZone()


// ── Main Call to Draw FVGs ──────────────────────────────────────
// daily and monthly are used for proximity test on higher timeframes
daily := request.security(syminfo.tickerid, '1D', ta.atr(14))
monthly := request.security(syminfo.tickerid, '1M', ta.atr(14))

int cnt = 0
int last = helper.HTFEnabled()

if showFvgs // barstate.isconfirmed
    if FVG_1.settings.show
        if helper.Validtimeframe(FVG_1.settings.htf)
            cnt := cnt + 1
            FVG_1.order := cnt
            FVG_1.check(FVG_1.settings.htf)

    if FVG_2.settings.show
        if helper.Validtimeframe(FVG_2.settings.htf)
            if cnt < last
                cnt := cnt + 1
                FVG_2.order := cnt
                FVG_2.check(FVG_2.settings.htf)

    if FVG_3.settings.show
        if helper.Validtimeframe(FVG_3.settings.htf)
            if cnt < last
                cnt := cnt + 1
                FVG_3.order := cnt
                FVG_3.check(FVG_3.settings.htf)

    if FVG_4.settings.show
        if helper.Validtimeframe(FVG_4.settings.htf)
            if cnt < last
                cnt := cnt + 1
                FVG_4.order := cnt
                FVG_4.check(FVG_4.settings.htf)


// ── Swing Helper Functions ──────────────────────────────────────

format_timeframe_label(tf) =>
    (
     str.tonumber(tf) <= 30 ? tf + "m" :
     tf == "60"  ? "1h"  :
     tf == "120" ? "2h"  :
     tf == "180" ? "3h"  :
     tf == "240" ? "4h"  :
     tf
    )

round_to_tick(base, price) =>
    t = price / syminfo.mintick
    price >= base ? math.ceil(t) * syminfo.mintick : math.floor(t) * syminfo.mintick


// ── Draw Swings ─────────────────────────────────────────
f_draw_swings(settings, labelOffsetBars, highLines, highLevels, highLabels, lowLines, lowLevels, lowLabels, allLines, oldHighLines, oldLowLines, oldHighLabels, oldLowLabels) =>

    bool touchedHigh = false
    bool touchedLow  = false

    futureTime = time + timeframe.in_seconds() * 1000 * labelOffsetBars

    [ph, pl, t_center, htfConfirmed] = request.security(
     syminfo.tickerid,
     settings.htf,
     [
         ta.pivothigh(high, swingLength, swingLength),
         ta.pivotlow(low, swingLength, swingLength),
         time[swingLength],
         barstate.isconfirmed
     ],
     barmerge.gaps_off,
     barmerge.lookahead_off)

    newHighPivot = htfConfirmed and not na(ph) and na(ph[1])
    newLowPivot  = htfConfirmed and not na(pl) and na(pl[1])

    if newHighPivot and not na(t_center)
        level = round_to_tick(ph, ph)

        l = line.new(
            t_center,
            level,
            time,
            level,
            xloc = xloc.bar_time,
            extend = extend.none,
            color = settings.color_bear,
            width = swingLineWidth,
            style = helper.LineStyle(swingLineStyle))
        
        lbl = label.new(
            time,
            level,
            format_timeframe_label(settings.htf),
            xloc = xloc.bar_time,
            style = label.style_none,
            color = color_transparent,
            textcolor = showSwingLabel ? settings.color_bear : color_transparent,
            size = swingLabelSize)

        array.push(highLines, l)
        array.push(highLevels, level)
        array.push(highLabels, lbl)
        array.push(allLines, l)

    if newLowPivot and not na(t_center)
        level = round_to_tick(pl, pl)

        l = line.new(
            t_center,
            level,
            time,
            level,
            xloc = xloc.bar_time,
            extend = extend.none,
            color = settings.color_bull,
            width = swingLineWidth,
            style = helper.LineStyle(swingLineStyle))

        lbl = label.new(
            time,
            level,
            format_timeframe_label(settings.htf),
            xloc = xloc.bar_time,
            style = label.style_none,
            color = color_transparent,
            textcolor = showSwingLabel ? settings.color_bull : color_transparent,
            size = swingLabelSize)

        array.push(lowLines, l)
        array.push(lowLevels, level)
        array.push(lowLabels, lbl)
        array.push(allLines, l)

    hiSz = array.size(highLevels)
    if hiSz > 0
        for i = hiSz - 1 to 0
            lvl = array.get(highLevels, i)
            ln  = array.get(highLines, i)
            lbl = array.get(highLabels, i)

            line.set_xy2(ln, futureTime, lvl)
            label.set_x(lbl, futureTime)
            label.set_y(lbl, lvl)

            if high >= lvl
                idx = array.indexof(allLines, ln)
                if idx >= 0
                    array.remove(allLines, idx)
                if showOldSwing
                    line.set_style(ln, old_swing_line_style)
                    line.set_color(ln, color.new(settings.color_bear, 30))
                    label.set_textcolor(lbl, color.new(showSwingLabel ? settings.color_bear : color_transparent, 30))
                    // label.set_style(lbl, label.style_label_down)

                    array.push(oldHighLines, ln)
                    array.push(oldHighLabels, lbl)
                    while array.size(oldHighLines) > oldSwingCount
                        oldLine  = array.shift(oldHighLines)
                        oldLabel = array.shift(oldHighLabels)

                        line.delete(oldLine)
                        label.delete(oldLabel)
                else
                    line.delete(ln)
                    label.delete(lbl)

                array.remove(highLevels, i)
                array.remove(highLines, i)
                array.remove(highLabels, i)
                touchedHigh := true

    loSz = array.size(lowLevels)
    if loSz > 0
        for i = loSz - 1 to 0
            lvl = array.get(lowLevels, i)
            ln  = array.get(lowLines, i)
            lbl = array.get(lowLabels, i)

            line.set_xy2(ln, futureTime, lvl)
            label.set_x(lbl, futureTime)
            label.set_y(lbl, lvl)

            if low <= lvl
                idx = array.indexof(allLines, ln)
                if idx >= 0
                    array.remove(allLines, idx)
                if showOldSwing
                    line.set_style(ln, old_swing_line_style)
                    line.set_color(ln, color.new(settings.color_bull, 30))
                    label.set_textcolor(lbl, color.new(showSwingLabel ? settings.color_bull : color_transparent, 30))
                    // label.set_style(lbl, label.style_label_up)

                    array.push(oldLowLines, ln)
                    array.push(oldLowLabels, lbl)
                    while array.size(oldLowLines) > oldSwingCount
                        oldLine  = array.shift(oldLowLines)
                        oldLabel = array.shift(oldLowLabels)

                        line.delete(oldLine)
                        label.delete(oldLabel)
                else
                    line.delete(ln)
                    label.delete(lbl)

                array.remove(lowLevels, i)
                array.remove(lowLines, i)
                array.remove(lowLabels, i)
                touchedLow := true

    while array.size(highLines) > settings.max_count
        oldLine  = array.shift(highLines)
        oldLabel = array.shift(highLabels)
        array.shift(highLevels)

        if not na(oldLine)
            line.delete(oldLine)
        if not na(oldLabel)
            label.delete(oldLabel)

        idx = array.indexof(allLines, oldLine)
        if idx >= 0
            array.remove(allLines, idx)

    while array.size(lowLines) > settings.max_count
        oldLine  = array.shift(lowLines)
        oldLabel = array.shift(lowLabels)
        array.shift(lowLevels)

        if not na(oldLine)
            line.delete(oldLine)
        if not na(oldLabel)
            label.delete(oldLabel)

        idx = array.indexof(allLines, oldLine)
        if idx >= 0
            array.remove(allLines, idx)

    [touchedHigh, touchedLow]

