    tLowHTF4 := tlHTF4


// Key-level types and helpers
type kz
    string _title
    array<box> _box
    array<line> _hi_line
    array<line> _lo_line
    array<label> _hi_label
    array<label> _lo_label
    array<bool> _hi_valid
    array<bool> _lo_valid
    array<float> _range_store
    float _range_current

type hz
    array<line> LN
    array<label> LB
    array<bool> CO

type dwm_hl
    array<line> hi_line
    array<line> lo_line
    array<label> hi_label
    array<label> lo_label
    bool hit_high = false
    bool hit_low = false
    int hit_high_time = na
    int hit_low_time = na

type dwm_info
    string tf
    float o = na
    float h = na
    float l = na
    float ph = na
    float pl = na

type lines_helper
    hz _hz
    string h
    string h_text
    color h_color

type kz_helper
    kz _kz
    string session
    string tz
    color c
    string hi_txt
    string lo_txt

initLines() =>
    array<lines_helper> res = array.new<lines_helper>()
    if use_h1
        res.push(lines_helper.new(hz.new(array.new_line(), array.new_label(), array.new_bool()), h1, h1_text, h1_color))
    if use_h2
        res.push(lines_helper.new(hz.new(array.new_line(), array.new_label(), array.new_bool()), h2, h2_text, h2_color))
    if use_h3
        res.push(lines_helper.new(hz.new(array.new_line(), array.new_label(), array.new_bool()), h3, h3_text, h3_color))
    if use_h4
        res.push(lines_helper.new(hz.new(array.new_line(), array.new_label(), array.new_bool()), h4, h4_text, h4_color))
    res

var array<lines_helper> key_lines = initLines()

new_kz_state(string title) =>
    kz.new(
        _title = title,
        _box = array.new_box(),
        _hi_line = array.new_line(),
        _lo_line = array.new_line(),
        _hi_label = array.new_label(),
        _lo_label = array.new_label(),
        _hi_valid = array.new_bool(),
        _lo_valid = array.new_bool(),
        _range_store = array.new_float())

initKZ() =>
    array<kz_helper> res = array.new<kz_helper>()
    if use_asia
        res.push(kz_helper.new(_kz = new_kz_state('Asia'), session = asia, tz = gmt_tz, c = as_color, hi_txt = 'AS.H', lo_txt = 'AS.L'))
    if use_london
        res.push(kz_helper.new(_kz = new_kz_state('London'), session = london, tz = gmt_tz, c = lo_color, hi_txt = 'LO.H', lo_txt = 'LO.L'))
    if use_nyam
        res.push(kz_helper.new(_kz = new_kz_state('New York'), session = nyam, tz = gmt_tz, c = na_color, hi_txt = 'NY.H', lo_txt = 'NY.L'))
    res

var array<kz_helper> key_zones = initKZ()

var d_hl = dwm_hl.new(array.new_line(), array.new_line(), array.new_label(), array.new_label())
var w_hl = dwm_hl.new(array.new_line(), array.new_line(), array.new_label(), array.new_label())
var m_hl = dwm_hl.new(array.new_line(), array.new_line(), array.new_label(), array.new_label())

var d_info = dwm_info.new("D")
var w_info = dwm_info.new("W")
var m_info = dwm_info.new("M")

var cutoff = "1600-1601"
t_co = not na(time("", cutoff, gmt_tz))


update_dwm_info(dwm_info n) =>
    if timeframe.change(n.tf)
        n.ph := n.h
        n.pl := n.l
        n.o := open
        n.h := high
        n.l := low
    else
        n.h := math.max(high, n.h)
        n.l := math.min(low, n.l)

if dhl
    update_dwm_info(d_info)
if whl
    update_dwm_info(w_info)
if mhl
    update_dwm_info(m_info)

dwm_hl(string tf, bool use, dwm_hl hl, dwm_info n, color col) =>
    if use
        int prev_period_time = ta.valuewhen(timeframe.change(tf), time, 1)
        int future_time = time + (not na(time[1]) ? time - time[1] : timeframe.in_seconds() * 1000) * dwm_extend_candles
        if hl.hi_line.size() > 0
            bool touched_high = not hl.hit_high and high >= hl.hi_line.get(0).get_y1()
            bool touched_low = not hl.hit_low and low <= hl.lo_line.get(0).get_y1()

            if touched_high
                hl.hit_high := true
                hl.hit_high_time := time
                if enableAlerts and alertKeyLevelBreak
                    alert(str.format("Hit P{0}H", tf))
            if touched_low
                hl.hit_low := true
                hl.hit_low_time := time
                if enableAlerts and alertKeyLevelBreak
                    alert(str.format("Hit P{0}L", tf))

            int hi_x2 = hl.hit_high ? hl.hit_high_time : future_time
            int lo_x2 = hl.hit_low ? hl.hit_low_time : future_time
            hl.hi_line.get(0).set_x2(hi_x2)
            hl.lo_line.get(0).set_x2(lo_x2)

            hl.hi_label.get(0).set_x(hi_x2)
            hl.hi_label.get(0).set_y(hl.hi_line.get(0).get_y1())
            hl.lo_label.get(0).set_x(lo_x2)
            hl.lo_label.get(0).set_y(hl.lo_line.get(0).get_y1())

            if hl.hit_high
                hl.hi_line.get(0).set_color(color.new(col, 70))
                hl.hi_label.get(0).set_textcolor(color.new(col, 70))
                hl.hi_label.get(0).set_style(label.style_label_down)
            if hl.hit_low
                hl.lo_line.get(0).set_color(color.new(col, 70))
                hl.lo_label.get(0).set_textcolor(color.new(col, 70))
                hl.lo_label.get(0).set_style(label.style_label_up)
        if timeframe.change(tf)
            hl.hi_line.unshift(line.new(prev_period_time, n.ph, time, n.ph, xloc = xloc.bar_time, style = helper.LineStyle(kzp_style), width = kzp_width, color = col))
            hl.lo_line.unshift(line.new(prev_period_time, n.pl, time, n.pl, xloc = xloc.bar_time, style = helper.LineStyle(kzp_style), width = kzp_width, color = col))
            hl.hi_label.unshift(label.new(time, n.ph, "P" + tf + "H", xloc = xloc.bar_time, style = label.style_label_left, color = color_transparent, textcolor = col, size = lbl_size))
            hl.lo_label.unshift(label.new(time, n.pl, "P" + tf + "L", xloc = xloc.bar_time, style = label.style_label_left, color = color_transparent, textcolor = col, size = lbl_size))
            hl.hit_high := false
            hl.hit_low := false
            hl.hit_high_time := na
            hl.hit_low_time := na
            if hl.hi_line.size() > max_days
                hl.hi_line.pop().delete()
                hl.lo_line.pop().delete()
                hl.hi_label.pop().delete()
                hl.lo_label.pop().delete()

dwm() =>
    if tf_limit_is_equal_or_more_chart_tf
        dwm_hl("D", dhl, d_hl, d_info, d_color)
        dwm_hl("W", whl, w_hl, w_info, w_color)
        dwm_hl("M", mhl, m_hl, m_info, m_color)

method hz_line(lines_helper this) =>
    bool t = not na(time("", this.h, gmt_tz))
    bool t_prev = not na(time("", this.h, gmt_tz, bars_back = 1))
    hz hz = this._hz
    string txt = this.h_text
    color col = this.h_color

    bool newTradingDay = ta.change(time("D", "1800-1759")) != 0

    if newTradingDay
        while hz.LN.size() > 0
            hz.LN.pop().delete()
            hz.LB.pop().delete()
            hz.CO.pop()
    if t and not t_prev
        hz.LN.unshift(line.new(bar_index, open, bar_index, open, style = helper.LineStyle(hz_style), width = hz_width, color = col))
        hz.LB.unshift(label.new(bar_index, open, txt, style = label.style_label_left, color = color_transparent, textcolor = col, size = lbl_size))
        array.unshift(hz.CO, false)
    if not t and hz.CO.size() > 0
        if not hz.CO.get(0)
            hz.LN.get(0).set_x2(bar_index + dwm_extend_candles)
            hz.LB.get(0).set_x(bar_index + dwm_extend_candles)
            if t_co
                hz.CO.set(0, true)

hz_lines() =>
    if tf_limit_is_equal_or_more_chart_tf
        for [_, value] in key_lines
            hz_line(value)

del_kz(kz k) =>
    if k._box.size() > max_days
        k._box.pop().delete()
    if k._hi_line.size() > max_days
        k._hi_line.pop().delete()
        k._lo_line.pop().delete()
        k._hi_valid.pop()
        k._lo_valid.pop()
    if k._hi_label.size() > max_days
        k._hi_label.pop().delete()
        k._lo_label.pop().delete()

adjust_in_kz(kz kz, bool t) =>
    if t
        kzBox0 = kz._box.get(0)
        kzBox0.set_right(time)
        newTop = math.max(kzBox0.get_top(), high)
        kzBox0.set_top(newTop)
        newBottom = math.min(kzBox0.get_bottom(), low)
        kzBox0.set_bottom(newBottom)

        kz._range_current := newTop - newBottom

        if kz._hi_line.size() > 0
            kzHiLine0 = kz._hi_line.get(0)
            kzHiLine0.set_x2(bar_index)
            if high > kzHiLine0.get_y1()
                kzHiLine0.set_xy1(bar_index, high)
                kzHiLine0.set_xy2(bar_index, high)

            kzLoLine0 = kz._lo_line.get(0)
            kzLoLine0.set_x2(bar_index)
            if low < kzLoLine0.get_y1()
                kzLoLine0.set_xy1(bar_index, low)
                kzLoLine0.set_xy2(bar_index, low)

        if kz._hi_label.size() > 0
            if label_right
                kz._hi_label.get(0).set_x(bar_index)
                kz._lo_label.get(0).set_x(bar_index)
            if high > kz._hi_label.get(0).get_y()
                if label_right
                    kz._hi_label.get(0).set_xy(bar_index, high)
                else
                    kz._hi_label.get(0).set_xy(time, high)
            if low < kz._lo_label.get(0).get_y()
                if label_right
                    kz._lo_label.get(0).set_xy(bar_index, low)
                else
                    kz._lo_label.get(0).set_xy(time, low)

adjust_out_kz(kz kz, bool t, bool t_prev) =>
    boxCount = kz._box.size()
    if not t and boxCount > 0
        if t_prev
            array.unshift(kz._range_store, kz._range_current)
            if kz._range_store.size() > 5
                kz._range_store.pop()

    if boxCount > 0
        for i = 0 to boxCount - 1 by 1
            if i == 0
                kzHiValid = kz._hi_valid.get(i)
                if kzHiValid
                    kz._hi_line.get(i).set_x2(bar_index + 3)
                    if label_right
                        kz._hi_label.get(i).set_x(bar_index + 3)
                if kzHiValid and high > kz._hi_line.get(i).get_y1()
                    if enableAlerts and alertKeyLevelBreak and i == 0
                        alert(kz._title + ' High Broken', alert.freq_once_per_bar)
                    kz._hi_valid.set(i, false)
                    if label_right
                        kz._hi_label.get(i).set_style(label.style_label_down)

                kzLoValid = kz._lo_valid.get(i)
                if kzLoValid
                    kz._lo_line.get(i).set_x2(bar_index + 3)
                    if label_right
                        kz._lo_label.get(i).set_x(bar_index + 3)
                if kzLoValid and low < kz._lo_line.get(i).get_y1()
                    if enableAlerts and alertKeyLevelBreak and i == 0
                        alert(kz._title + " Low Broken", alert.freq_once_per_bar)
                    kz._lo_valid.set(i, false)
                    if label_right
                        kz._lo_label.get(i).set_style(label.style_label_up)
            else
                break

method manage_kz(kz_helper this) =>
    kz kz = this._kz
    c = this.c
    string hi_txt = this.hi_txt
    string lo_txt = this.lo_txt

    if tf_limit_is_equal_or_more_chart_tf
        t = not na(time("", this.session, this.tz))
        t_prev = not na(time("", this.session, this.tz, bars_back = 1))
        if t and not t_prev
            kz._box.unshift(box.new(time, high, time, low, xloc = xloc.bar_time, border_color = na, bgcolor = na, text_color = na))
            kz._hi_line.unshift(line.new(bar_index, high, bar_index, high, xloc = xloc.bar_index, style = helper.LineStyle(kzp_style), color = c, width = kzp_width))
            kz._lo_line.unshift(line.new(bar_index, low, bar_index, low, xloc = xloc.bar_index, style = helper.LineStyle(kzp_style), color = c, width = kzp_width))
            array.unshift(kz._hi_valid, true)
            array.unshift(kz._lo_valid, true)
            if label_right
                kz._hi_label.unshift(label.new(bar_index, high, hi_txt, xloc = xloc.bar_index, color = color_transparent, textcolor = c, style = label.style_label_left, size = lbl_size))
                kz._lo_label.unshift(label.new(bar_index, low, lo_txt, xloc = xloc.bar_index, color = color_transparent, textcolor = c, style = label.style_label_left, size = lbl_size))
            else
                kz._hi_label.unshift(label.new(time, high, hi_txt, xloc = xloc.bar_time, color = color_transparent, textcolor = c, style = label.style_label_down, size = lbl_size))
                kz._lo_label.unshift(label.new(time, low, lo_txt, xloc = xloc.bar_time, color = color_transparent, textcolor = c, style = label.style_label_up, size = lbl_size))
            del_kz(kz)
        adjust_in_kz(kz, t)
        adjust_out_kz(kz, t, t_prev)

if showKeyLevels
    for [_, value] in key_zones
        manage_kz(value)
    dwm()
if showOpenLines
    hz_lines()

// ── Swing Alerts ─────────────────────────

// combine all TF touches
touchedHighThisBar := tHighHTF1 or tHighHTF2 or tHighHTF3 or tHighHTF4
touchedLowThisBar  := tLowHTF1  or tLowHTF2 or tLowHTF3 or tLowHTF4

anyTouch = touchedHighThisBar or touchedLowThisBar
bothTouch = touchedHighThisBar and touchedLowThisBar

// ── Dynamic Alert Message ─────────────────────────
string highTFs = ""
string lowTFs  = ""

// Highs
if tHighHTF1
    highTFs += format_timeframe_label(HTF_1_Swing_Settings.htf) + ", "

if tHighHTF2
    highTFs += format_timeframe_label(HTF_2_Swing_Settings.htf) + ", "

if tHighHTF3
    highTFs += format_timeframe_label(HTF_3_Swing_Settings.htf) + ", "

if tHighHTF4
    highTFs += format_timeframe_label(HTF_4_Swing_Settings.htf) + ", "
// Lows
if tLowHTF1
    lowTFs += format_timeframe_label(HTF_1_Swing_Settings.htf) + ", "

if tLowHTF2
    lowTFs += format_timeframe_label(HTF_2_Swing_Settings.htf) + ", "

if tLowHTF3
    lowTFs += format_timeframe_label(HTF_3_Swing_Settings.htf) + ", "

if tLowHTF4
    lowTFs += format_timeframe_label(HTF_4_Swing_Settings.htf) + ", "

// Build final message
string touchedMsg = ""

// High message
if alertSwingsBreak and str.length(highTFs) > 2
    highTFs := str.substring(highTFs, 0, str.length(highTFs) - 2)
    touchedMsg += highTFs + " Swing High Broken"

// Low message
if alertSwingsBreak and str.length(lowTFs) > 2
    lowTFs := str.substring(lowTFs, 0, str.length(lowTFs) - 2)

    if touchedMsg != ""
        touchedMsg += " | "

    touchedMsg += lowTFs + " Swing Low Broken"

// Trading Session
inAsiaSession     = not na(time(timeframe.period, asiaSession))
inLondonSession   = not na(time(timeframe.period, londonSession))
inNewYorkSession  = not na(time(timeframe.period, newYorkSession))

allowAlert =
     (alertAsia and inAsiaSession) or
     (alertLondon and inLondonSession) or
     (alertNewYork and inNewYorkSession)

// Fire alert
if enableAlerts and allowAlert and touchedMsg != ""
    alert(touchedMsg, alert.freq_once_per_bar)
