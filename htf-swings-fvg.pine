//@version=6
indicator('HTF Swings & FVG', 'HTF Swings & FVG', overlay = true, max_bars_back = 5000, max_lines_count = 500)

type TimeframeSettings
	bool show
	string htf
	color color_bull
	color color_bear
	color color_bull_ce
	color color_bear_ce
	int max_count

type ZoneBox
	line open
	line close
	line ce
	linefill fill
	label label_ce

type FvgZone
	int open_time
	int close_time
	float open
	float middle
	float close
	bool mitigated
	int mitigated_time
	bool isbullish
	ZoneBox box2

type FvgStructure
	array<FvgZone> imbalance
	TimeframeSettings settings
	int order = 1
	int step = 0

type ScriptHelper
	string name = 'Helper'
    
