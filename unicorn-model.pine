//@version=6
indicator("Unicorn Model (Just)", shorttitle = "Unicorn Model (Just)", overlay = true, max_bars_back = 5000, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)
import mindyourbuisness/CustomAlertLib/3 as CAL

type BreakerSetup
    string          dir
    int             sweepIndex
    float           sweepExtreme
    float           sweptLevel
    int             sweptLevelStartBar
    int             breakerStartIdx
    int             breakerEndIdx
    float           breakerTop
    float           breakerBottom
    bool            isConfirmed
    int             confIndex
    float           entryPrice
    float           invalidationPrice
    bool            isInvalidated
    bool            isTargetHit
    line            levelLine
    label           levelLabel
    box             breakerBox
    box             fvgBox
    line[]          targetLines
    label[]         targetLabels
    label           setupLabel
type BreakerHTFLevel
    string          tfLabel
    string          levelType
    bool            isHigh
    float           price
    int             startBar
    bool            isSwept
    int             sweepBar
    string          labelText

type AlertState
    bool            longCisdLive
    bool            shortCisdLive
    bool            longCisdConfirmed
    bool            shortCisdConfirmed
    bool            c3CisdLong
    bool            c3CisdShort
    bool            longBreaker
    bool            shortBreaker
    bool            bullishC2Closed
    bool            bearishC2Closed

string GRP_BREAKER = "Unicorn Model"
enable_breaker_model = true //input.bool(true, "Enable Breaker Model", group=GRP_BREAKER)

breaker_history        = input.int(2, "History", minval=1, group=GRP_BREAKER)

breaker_bull_color     = input.color(color.new(#4dd0e1, 85), "Bullish (Fill,Border,FVG)", inline='bu1', group=GRP_BREAKER)
breaker_bull_border    = input.color(color.new(#4dd0e1, 100), "", inline='bu1', group=GRP_BREAKER)
breaker_bull_fvg_color = input.color(color.new(#4dd0e1, 70), "", inline='bu1', group=GRP_BREAKER)

breaker_bear_color     = input.color(color.new(#f06292, 85), "Bearish (Fill,Border,FVG)", inline='be1',  group=GRP_BREAKER)
breaker_bear_border    = input.color(color.new(#f06292, 100), "", inline='be1',  group=GRP_BREAKER)
breaker_bear_fvg_color = input.color(color.new(#f06292, 70), "", inline='be1', group=GRP_BREAKER)


breaker_inactive_color = input.color(color.new(color.gray, 85), "Inactive Color", group=GRP_BREAKER)

breaker_label_color    = input.color(color.black, "Label Color", group=GRP_BREAKER)

breaker_show_rr_target = input.bool(true, "Show RR Target")
breaker_rr_ratio       = input.float(2.0, "RR Ratio", minval=0.1, step=0.1)

breaker_require_fvg = true
breaker_use_sweep_invalidation = false
breaker_discard_invalidated = false
breaker_enable_fvg_atr_filter = false
breaker_fvg_atr_mult = 0.5

string GRP_DISPLAY = "DISPLAY & ALERTS"
alertFormat = input.text_area('{"ticker":"{ticker}", "interval":"{interval}", "alert":"{default}"}', "Custom Alert Message Format", group=GRP_DISPLAY)
enable_alerts = input.bool(true, "Enable Alerts", group=GRP_DISPLAY)
alert_breaker_setup = input.bool(true, "Long / Short Breaker", group=GRP_DISPLAY, active=enable_alerts)

var BreakerHTFLevel[] breaker_active_levels = array.new<BreakerHTFLevel>()
var BreakerSetup[] breaker_setups = array.new<BreakerSetup>()
var int breaker_pending_bull_sweep_idx = na
var int breaker_pending_bull_first_sweep_bar = na
var float breaker_pending_bull_extreme = na
var float breaker_pending_bull_level = na
var int breaker_pending_bull_level_start_bar = na
var string breaker_pending_bull_label_text = ""
var int breaker_pending_bear_sweep_idx = na
var int breaker_pending_bear_first_sweep_bar = na
var float breaker_pending_bear_extreme = na
var float breaker_pending_bear_level = na
var int breaker_pending_bear_level_start_bar = na
var string breaker_pending_bear_label_text = ""
var float breaker_last_prev_high_a = na
var float breaker_last_prev_low_a = na
var float breaker_last_swing_high_a = na
var float breaker_last_swing_low_a = na
var float breaker_last_prev_high_b = na
var float breaker_last_prev_low_b = na
var float breaker_last_swing_high_b = na
var float breaker_last_swing_low_b = na
var float breaker_last_prev_high_c = na
var float breaker_last_prev_low_c = na
var float breaker_last_swing_high_c = na
var float breaker_last_swing_low_c = na
var float breaker_last_prev_high_d = na
var float breaker_last_prev_low_d = na
var float breaker_last_swing_high_d = na
var float breaker_last_swing_low_d = na
var AlertState alerts = AlertState.new(false, false, false, false, false, false, false, false, false, false)

breakerTFLabel(string tf) =>
    seconds = timeframe.in_seconds(tf)
    string res = ""
    if seconds < 60
        res := str.tostring(seconds) + "S"
    else if (seconds / 60) < 60
        res := str.tostring(math.round(seconds / 60)) + "m"
    else if (seconds / 3600) < 24
        res := str.tostring(math.round(seconds / 3600)) + "H"
    else if (seconds / 86400) < 7
        res := str.tostring(math.round(seconds / 86400)) + "D"
    else if (seconds / 86400) < 30
        res := str.tostring(math.round(seconds / 604800)) + "W"
    else
        res := str.tostring(math.round(seconds / 2592000)) + "M"
    res
breakerHTFByVal(int idx) =>
    switch idx
        1 => "15"
        2 => "30"
        3 => "60"
        4 => "150"
        5 => "240"
        6 => "1D"
        7 => "720"
        8 => "1D"
        9 => "2D"
        10 => "W"
        11 => "4D"
        12 => "W"
        13 => "15D"
        14 => "45D"
        15 => "15W"
        16 => "15M"
        => "60"
breakerAutoHTFs() =>
    int tf = timeframe.in_seconds()
    int k = 1
    if tf <= 15
        k := 1
    else if tf <= 60
        k := 1
    else if tf <= 180
        k := 2
    else if tf <= 300
        k := 3
    else if tf <= 600
        k := 4
    else if tf <= 900
        k := 5
    else if tf <= 1800
        k := 6
    else if tf <= 2700
        k := 7
    else if tf <= 3600
        k := 8
    else if tf <= 7200
        k := 9
    else if tf <= 14400
        k := 10
    else if tf <= 21600
        k := 11
    else if tf <= 43200
        k := 12
    else if tf <= 86400
        k := 13
    else if tf <= 259200
        k := 14
    else if tf <= 604800
        k := 15
    else if tf <= 2592000
        k := 16
    else
        k := 17
    string resolvedA = k - 1 >= 0 ? breakerHTFByVal(k - 1) : ""
    string resolvedB = breakerHTFByVal(k)
    string resolvedC = breakerHTFByVal(k + 1)
    string resolvedD = breakerHTFByVal(k + 2)
    [resolvedA, resolvedB, resolvedC, resolvedD]
breakerHTFData() =>
    hPrev = high[1]
    lPrev = low[1]
    isSwingHigh = high > high[1] and close < close[1]
    isSwingLow = low < low[1] and close > close[1]
    latestSH = ta.valuewhen(isSwingHigh, high, 0)
    latestSL = ta.valuewhen(isSwingLow, low, 0)
    [hPrev, lPrev, latestSH, latestSL]
breakerFindExtremeBar(float priceVal, bool isHigh) =>
    int extBar = na
    if not na(priceVal)
        for i = 0 to 1000
            if i >= bar_index
                break
            float checkVal = isHigh ? high[i] : low[i]
            if math.abs(checkVal - priceVal) < (syminfo.mintick * 0.1)
                extBar := bar_index - i
                break
    extBar
breakerRegisterLevel(string tfLabel, string lvlType, bool isHigh, float priceVal) =>
    if enable_breaker_model and not na(priceVal)
        int extBar = breakerFindExtremeBar(priceVal, isHigh)
        int startB = na(extBar) ? bar_index : extBar
        int startSearch = math.max(startB + 1, bar_index - 999)
        bool alreadyBreached = false
        if not na(extBar) and startSearch <= bar_index - 1
            for i = startSearch to bar_index - 1
                float checkHigh = high[bar_index - i]
                float checkLow = low[bar_index - i]
                if isHigh and checkHigh >= priceVal
                    alreadyBreached := true
                    break
                else if not isHigh and checkLow <= priceVal
                    alreadyBreached := true
                    break
        if not alreadyBreached
            bool exists = false
            if breaker_active_levels.size() > 0
                for i = 0 to breaker_active_levels.size() - 1
                    BreakerHTFLevel lvl = breaker_active_levels.get(i)
                    if not lvl.isSwept and lvl.isHigh == isHigh and math.abs(lvl.price - priceVal) < (syminfo.mintick * 0.1)
                        string searchStr = tfLabel + " " + lvlType
                        if not str.contains(lvl.labelText, searchStr)
                            lvl.labelText := lvl.labelText + ", " + searchStr
                            breaker_active_levels.set(i, lvl)
                        exists := true
                        break
            if not exists
                BreakerHTFLevel newLvl = BreakerHTFLevel.new(tfLabel, lvlType, isHigh, priceVal, startB, false, na, tfLabel + " " + lvlType)
                breaker_active_levels.push(newLvl)
breakerSizeFilter(float breakerTop, float breakerBottom) =>
    true
breakerFindUpCandlesSeries(int sweepOffset) =>
    int startOffset = na
    int endOffset = na
    int maxOffset = math.min(sweepOffset + 40, bar_index)
    if sweepOffset <= maxOffset
        for i = sweepOffset to maxOffset
            if close[i] > open[i]
                int tempEnd = i
                int runMax = math.min(i + 20, bar_index)
                if i + 1 <= runMax
                    for j = i + 1 to runMax
                        if close[j] > open[j]
                            tempEnd := j
                        else
                            break
                runLength = tempEnd - i + 1
                if runLength >= 2
                    startOffset := i
                    endOffset := tempEnd
                    break
    [startOffset, endOffset]
breakerFindDownCandlesSeries(int sweepOffset) =>
    int startOffset = na
    int endOffset = na
    int maxOffset = math.min(sweepOffset + 40, bar_index)
    if sweepOffset <= maxOffset
        for i = sweepOffset to maxOffset
            if close[i] < open[i]
                int tempEnd = i
                int runMax = math.min(i + 20, bar_index)
                if i + 1 <= runMax
                    for j = i + 1 to runMax
                        if close[j] < open[j]
                            tempEnd := j
                        else
                            break
                runLength = tempEnd - i + 1
                if runLength >= 2
                    startOffset := i
                    endOffset := tempEnd
                    break
    [startOffset, endOffset]
breakerSeriesRange(int startOffset, int endOffset) =>
    float maxH = na
    float minL = na
    if not na(startOffset) and not na(endOffset)
        for i = startOffset to endOffset
            maxH := na(maxH) ? high[i] : math.max(maxH, high[i])
            minL := na(minL) ? low[i] : math.min(minL, low[i])
    [maxH, minL]
breakerFindBullishFVG(float breakerTop, float breakerBottom, int breakerStartBar) =>
    float fvgTop = na
    float fvgBottom = na
    int fvgLeft = na
    int fvgRight = na
    int limit = math.min(bar_index - breakerStartBar, 100)
    if limit >= 0
        for i = 0 to limit
            if low[i] > high[i + 2]
                top = low[i]
                bottom = high[i + 2]
                atrVal = ta.atr(14)[i]
                if breaker_enable_fvg_atr_filter and (top - bottom) < (atrVal * breaker_fvg_atr_mult)
                    continue
                overlaps = math.max(bottom, breakerBottom) < math.min(top, breakerTop)
                if overlaps
                    bool unmitigated = true
                    for j = 0 to i
                        if low[j] < bottom
                            unmitigated := false
                            break
                    if unmitigated
                        fvgTop := top
                        fvgBottom := bottom
                        fvgLeft := bar_index - i - 1
                        fvgRight := bar_index - i
                        break
    [fvgTop, fvgBottom, fvgLeft, fvgRight]
breakerFindBearishFVG(float breakerTop, float breakerBottom, int breakerStartBar) =>
    float fvgTop = na
    float fvgBottom = na
    int fvgLeft = na
    int fvgRight = na
    int limit = math.min(bar_index - breakerStartBar, 100)
    if limit >= 0
        for i = 0 to limit
            if high[i] < low[i + 2]
                top = low[i + 2]
                bottom = high[i]
                atrVal = ta.atr(14)[i]
                if breaker_enable_fvg_atr_filter and (top - bottom) < (atrVal * breaker_fvg_atr_mult)
                    continue
                overlaps = math.max(bottom, breakerBottom) < math.min(top, breakerTop)
                if overlaps
                    bool unmitigated = true
                    for j = 0 to i
                        if high[j] > top
                            unmitigated := false
                            break
                    if unmitigated
                        fvgTop := top
                        fvgBottom := bottom
                        fvgLeft := bar_index - i - 1
                        fvgRight := bar_index - i
                        break
    [fvgTop, fvgBottom, fvgLeft, fvgRight]
deleteBreakerSetup(BreakerSetup setup) =>
    if not na(setup.levelLine)
        line.delete(setup.levelLine)
    if not na(setup.levelLabel)
        label.delete(setup.levelLabel)
    if not na(setup.breakerBox)
        box.delete(setup.breakerBox)
    if not na(setup.fvgBox)
        box.delete(setup.fvgBox)
    if array.size(setup.targetLines) > 0
        for l in setup.targetLines
            line.delete(l)
    if array.size(setup.targetLabels) > 0
        for lb in setup.targetLabels
            label.delete(lb)
    if not na(setup.setupLabel)
        label.delete(setup.setupLabel)
clearBreakerSetups() =>
    while breaker_setups.size() > 0
        BreakerSetup old_setup = breaker_setups.pop()
        deleteBreakerSetup(old_setup)
    while breaker_active_levels.size() > 0
        breaker_active_levels.pop()
addBreakerSetup(bool bullish, int breakerStartOffset, int breakerEndOffset, int sweepBar, int sweptLevelStartBar, string sweptLabelText, float breakerTop, float breakerBottom, float sweptLevel, float invalidation, bool hasFvg, float fvgTop, float fvgBottom, int fvgLeft, int fvgRight) =>
    int breakerStartIdx = bar_index - breakerStartOffset
    int breakerEndIdx = bar_index - breakerEndOffset
    setupColor = bullish ? breaker_bull_color : breaker_bear_color
    mid = (breakerTop + breakerBottom) / 2.0
    borderColor = bullish ? breaker_bull_border : breaker_bear_border
    box breakerBox = box.new(left=breakerEndIdx, top=breakerTop, right=bar_index, bottom=breakerBottom, border_color=borderColor, bgcolor=setupColor, xloc=xloc.bar_index)
    box fvgBox = na
    if hasFvg
        fvgBox := box.new(left=fvgLeft, top=fvgTop, right=fvgRight, bottom=fvgBottom, border_color=color.new(color.white, 100), bgcolor=bullish ? breaker_bull_fvg_color : breaker_bear_fvg_color, xloc=xloc.bar_index)
    int lineStartB = math.max(sweptLevelStartBar, bar_index - 4500)
    line levelLine = line.new(lineStartB, sweptLevel, sweepBar, sweptLevel, color=color.gray, style=line.style_dotted, width=1)
    label levelLabel = label.new(lineStartB, sweptLevel + (nz(ta.atr(14)) * 0.1), sweptLabelText, color=color.new(color.white, 100), textcolor=breaker_label_color, style=label.style_label_left, size=size.tiny, text_font_family=font.family_monospace)
    labelText = bullish ? (hasFvg ? "+Unicorn" : "+Breaker") : (hasFvg ? "-Unicorn" : "-Breaker")
    tooltipText = "Setup: " + (bullish ? (hasFvg ? "Bullish Unicorn" : "Bullish Breaker") : (hasFvg ? "Bearish Unicorn" : "Bearish Breaker")) + "\n" +
         "Swept Level: " + str.tostring(sweptLevel, format.mintick) + "\n" +
         "Entry: " + str.tostring(close, format.mintick) + "\n" +
         "Stop Loss: " + str.tostring(invalidation, format.mintick)
    label setupLabel = label.new(bar_index, mid, labelText, color=color.new(color.white, 100), textcolor=breaker_label_color, style=label.style_label_right, size=size.small, text_font_family=font.family_monospace, tooltip=tooltipText)
    riskRange = bullish ? close - invalidation : invalidation - close
    line[] targetLines = array.new_line()
    label[] targetLabels = array.new_label()
    if breaker_show_rr_target and riskRange > 0
        targetPrice = close + (bullish ? 1 : -1) * breaker_rr_ratio * riskRange
        l = line.new(breakerEndIdx, targetPrice, bar_index, targetPrice, color=breaker_label_color, style=line.style_dotted, width=1)
        lbl = label.new(bar_index, targetPrice, str.tostring(breaker_rr_ratio, "#.##") + "R", color=color.new(color.white, 100), textcolor=breaker_label_color, style=label.style_label_left, size=size.small, tooltip="Target level: " + str.tostring(targetPrice, format.mintick), text_font_family=font.family_monospace)
        array.push(targetLines, l)
        array.push(targetLabels, lbl)
    BreakerSetup setup = BreakerSetup.new(bullish ? "BULL" : "BEAR", sweepBar, bullish ? breaker_pending_bull_extreme : breaker_pending_bear_extreme, sweptLevel, sweptLevelStartBar, breakerStartIdx, breakerEndIdx, breakerTop, breakerBottom, true, bar_index, close, invalidation, false, false, levelLine, levelLabel, breakerBox, fvgBox, targetLines, targetLabels, setupLabel)
    breaker_setups.push(setup)
    if bullish
        alerts.longBreaker := true
    else
        alerts.shortBreaker := true
    if enable_alerts and alert_breaker_setup
        CAL.customAlert(alertFormat, (bullish ? "Long Breaker" : "Short Breaker") + " setup on " + syminfo.ticker + " (" + timeframe.period + ")")
    while breaker_setups.size() > breaker_history
        BreakerSetup old_setup = array.shift(breaker_setups)
        deleteBreakerSetup(old_setup)
updateBreakerSetups() =>
    if breaker_setups.size() > 0
        for idx = breaker_setups.size() - 1 to 0
            BreakerSetup setup = breaker_setups.get(idx)
            if not setup.isInvalidated
                bool invalidated = setup.dir == "BULL" ? low < setup.invalidationPrice : high > setup.invalidationPrice
                if invalidated
                    setup.isInvalidated := true
                    if breaker_discard_invalidated
                        deleteBreakerSetup(setup)
                        array.remove(breaker_setups, idx)
                        continue
                    else
                        box.set_border_color(setup.breakerBox, breaker_inactive_color)
                        box.set_bgcolor(setup.breakerBox, breaker_inactive_color)
                        if not na(setup.fvgBox)
                            box.set_bgcolor(setup.fvgBox, breaker_inactive_color)
                        label.set_textcolor(setup.setupLabel, color.gray)
                        if array.size(setup.targetLines) > 0
                            for l in setup.targetLines
                                line.delete(l)
                        if array.size(setup.targetLabels) > 0
                            for lb in setup.targetLabels
                                label.delete(lb)
                        array.clear(setup.targetLines)
                        array.clear(setup.targetLabels)
                else
                    box.set_right(setup.breakerBox, bar_index)
                    label.set_x(setup.setupLabel, bar_index)
                    if array.size(setup.targetLines) > 0
                        for i = array.size(setup.targetLines) - 1 to 0
                            l = array.get(setup.targetLines, i)
                            lb = array.get(setup.targetLabels, i)
                            targetVal = line.get_y1(l)
                            targetHit = setup.dir == "BULL" ? high >= targetVal : low <= targetVal
                            if targetHit
                                setup.isTargetHit := true
                                line.delete(l)
                                label.delete(lb)
                                array.remove(setup.targetLines, i)
                                array.remove(setup.targetLabels, i)
            breaker_setups.set(idx, setup)


alerts.longBreaker := false
alerts.shortBreaker := false
[breaker_auto_a, breaker_auto_b, breaker_auto_c, breaker_auto_d] = breakerAutoHTFs()
breaker_auto_a_valid = breaker_auto_a != ""
breaker_htf_a = breaker_auto_a_valid ? breaker_auto_a : timeframe.period
breaker_htf_b = breaker_auto_b
breaker_htf_c = breaker_auto_c
breaker_htf_d = breaker_auto_d
[breaker_prev_high_a, breaker_prev_low_a, breaker_swing_high_a, breaker_swing_low_a] = request.security(syminfo.tickerid, breaker_htf_a, breakerHTFData(), barmerge.gaps_off, barmerge.lookahead_off)
[breaker_prev_high_b, breaker_prev_low_b, breaker_swing_high_b, breaker_swing_low_b] = request.security(syminfo.tickerid, breaker_htf_b, breakerHTFData(), barmerge.gaps_off, barmerge.lookahead_off)
[breaker_prev_high_c, breaker_prev_low_c, breaker_swing_high_c, breaker_swing_low_c] = request.security(syminfo.tickerid, breaker_htf_c, breakerHTFData(), barmerge.gaps_off, barmerge.lookahead_off)
[breaker_prev_high_d, breaker_prev_low_d, breaker_swing_high_d, breaker_swing_low_d] = request.security(syminfo.tickerid, breaker_htf_d, breakerHTFData(), barmerge.gaps_off, barmerge.lookahead_off)
if not enable_breaker_model
    clearBreakerSetups()
    breaker_pending_bull_sweep_idx := na
    breaker_pending_bull_first_sweep_bar := na
    breaker_pending_bull_extreme := na
    breaker_pending_bull_level := na
    breaker_pending_bull_level_start_bar := na
    breaker_pending_bull_label_text := ""
    breaker_pending_bear_sweep_idx := na
    breaker_pending_bear_first_sweep_bar := na
    breaker_pending_bear_extreme := na
    breaker_pending_bear_level := na
    breaker_pending_bear_level_start_bar := na
    breaker_pending_bear_label_text := ""
    breaker_last_prev_high_a := na
    breaker_last_prev_low_a := na
    breaker_last_swing_high_a := na
    breaker_last_swing_low_a := na
    breaker_last_prev_high_b := na
    breaker_last_prev_low_b := na
    breaker_last_swing_high_b := na
    breaker_last_swing_low_b := na
    breaker_last_prev_high_c := na
    breaker_last_prev_low_c := na
    breaker_last_swing_high_c := na
    breaker_last_swing_low_c := na
    breaker_last_prev_high_d := na
    breaker_last_prev_low_d := na
    breaker_last_swing_high_d := na
    breaker_last_swing_low_d := na
else
    if breaker_auto_a_valid
        if breaker_prev_high_a != breaker_last_prev_high_a or (na(breaker_last_prev_high_a) and not na(breaker_prev_high_a))
            breaker_last_prev_high_a := breaker_prev_high_a
            breakerRegisterLevel(breakerTFLabel(breaker_htf_a), "OHLC", true, breaker_prev_high_a)
        if breaker_prev_low_a != breaker_last_prev_low_a or (na(breaker_last_prev_low_a) and not na(breaker_prev_low_a))
            breaker_last_prev_low_a := breaker_prev_low_a
            breakerRegisterLevel(breakerTFLabel(breaker_htf_a), "OHLC", false, breaker_prev_low_a)
        if breaker_swing_high_a != breaker_last_swing_high_a or (na(breaker_last_swing_high_a) and not na(breaker_swing_high_a))
            breaker_last_swing_high_a := breaker_swing_high_a
            breakerRegisterLevel(breakerTFLabel(breaker_htf_a), "Swing", true, breaker_swing_high_a)
        if breaker_swing_low_a != breaker_last_swing_low_a or (na(breaker_last_swing_low_a) and not na(breaker_swing_low_a))
            breaker_last_swing_low_a := breaker_swing_low_a
            breakerRegisterLevel(breakerTFLabel(breaker_htf_a), "Swing", false, breaker_swing_low_a)
    if breaker_prev_high_b != breaker_last_prev_high_b or (na(breaker_last_prev_high_b) and not na(breaker_prev_high_b))
        breaker_last_prev_high_b := breaker_prev_high_b
        breakerRegisterLevel(breakerTFLabel(breaker_htf_b), "OHLC", true, breaker_prev_high_b)
    if breaker_prev_low_b != breaker_last_prev_low_b or (na(breaker_last_prev_low_b) and not na(breaker_prev_low_b))
        breaker_last_prev_low_b := breaker_prev_low_b
        breakerRegisterLevel(breakerTFLabel(breaker_htf_b), "OHLC", false, breaker_prev_low_b)
    if breaker_swing_high_b != breaker_last_swing_high_b or (na(breaker_last_swing_high_b) and not na(breaker_swing_high_b))
        breaker_last_swing_high_b := breaker_swing_high_b
        breakerRegisterLevel(breakerTFLabel(breaker_htf_b), "Swing", true, breaker_swing_high_b)
    if breaker_swing_low_b != breaker_last_swing_low_b or (na(breaker_last_swing_low_b) and not na(breaker_swing_low_b))
        breaker_last_swing_low_b := breaker_swing_low_b
        breakerRegisterLevel(breakerTFLabel(breaker_htf_b), "Swing", false, breaker_swing_low_b)
    if breaker_prev_high_c != breaker_last_prev_high_c or (na(breaker_last_prev_high_c) and not na(breaker_prev_high_c))
        breaker_last_prev_high_c := breaker_prev_high_c
        breakerRegisterLevel(breakerTFLabel(breaker_htf_c), "OHLC", true, breaker_prev_high_c)
    if breaker_prev_low_c != breaker_last_prev_low_c or (na(breaker_last_prev_low_c) and not na(breaker_prev_low_c))
        breaker_last_prev_low_c := breaker_prev_low_c
        breakerRegisterLevel(breakerTFLabel(breaker_htf_c), "OHLC", false, breaker_prev_low_c)
    if breaker_swing_high_c != breaker_last_swing_high_c or (na(breaker_last_swing_high_c) and not na(breaker_swing_high_c))
        breaker_last_swing_high_c := breaker_swing_high_c
        breakerRegisterLevel(breakerTFLabel(breaker_htf_c), "Swing", true, breaker_swing_high_c)
    if breaker_swing_low_c != breaker_last_swing_low_c or (na(breaker_last_swing_low_c) and not na(breaker_swing_low_c))
        breaker_last_swing_low_c := breaker_swing_low_c
        breakerRegisterLevel(breakerTFLabel(breaker_htf_c), "Swing", false, breaker_swing_low_c)
    if breaker_prev_high_d != breaker_last_prev_high_d or (na(breaker_last_prev_high_d) and not na(breaker_prev_high_d))
        breaker_last_prev_high_d := breaker_prev_high_d
        breakerRegisterLevel(breakerTFLabel(breaker_htf_d), "OHLC", true, breaker_prev_high_d)
    if breaker_prev_low_d != breaker_last_prev_low_d or (na(breaker_last_prev_low_d) and not na(breaker_prev_low_d))
        breaker_last_prev_low_d := breaker_prev_low_d
        breakerRegisterLevel(breakerTFLabel(breaker_htf_d), "OHLC", false, breaker_prev_low_d)
    if breaker_swing_high_d != breaker_last_swing_high_d or (na(breaker_last_swing_high_d) and not na(breaker_swing_high_d))
        breaker_last_swing_high_d := breaker_swing_high_d
        breakerRegisterLevel(breakerTFLabel(breaker_htf_d), "Swing", true, breaker_swing_high_d)
    if breaker_swing_low_d != breaker_last_swing_low_d or (na(breaker_last_swing_low_d) and not na(breaker_swing_low_d))
        breaker_last_swing_low_d := breaker_swing_low_d
        breakerRegisterLevel(breakerTFLabel(breaker_htf_d), "Swing", false, breaker_swing_low_d)
    bool breaker_swept_bull = false
    float breaker_swept_bull_price = na
    int breaker_swept_bull_start_bar = na
    string breaker_swept_bull_label = ""
    bool breaker_swept_bear = false
    float breaker_swept_bear_price = na
    int breaker_swept_bear_start_bar = na
    string breaker_swept_bear_label = ""
    if breaker_active_levels.size() > 0
        for idx = breaker_active_levels.size() - 1 to 0
            BreakerHTFLevel lvl = breaker_active_levels.get(idx)
            bool swept = false
            if lvl.isHigh
                if high >= lvl.price
                    swept := true
                    breaker_swept_bull := true
                    if na(breaker_swept_bull_price) or lvl.price > breaker_swept_bull_price
                        breaker_swept_bull_price := lvl.price
                        breaker_swept_bull_start_bar := lvl.startBar
                        breaker_swept_bull_label := lvl.labelText
                    else if lvl.price == breaker_swept_bull_price and not str.contains(breaker_swept_bull_label, lvl.labelText)
                        breaker_swept_bull_label := breaker_swept_bull_label + ", " + lvl.labelText
            else
                if low <= lvl.price
                    swept := true
                    breaker_swept_bear := true
                    if na(breaker_swept_bear_price) or lvl.price < breaker_swept_bear_price
                        breaker_swept_bear_price := lvl.price
                        breaker_swept_bear_start_bar := lvl.startBar
                        breaker_swept_bear_label := lvl.labelText
                    else if lvl.price == breaker_swept_bear_price and not str.contains(breaker_swept_bear_label, lvl.labelText)
                        breaker_swept_bear_label := breaker_swept_bear_label + ", " + lvl.labelText
            if swept
                lvl.isSwept := true
                lvl.sweepBar := bar_index
                array.remove(breaker_active_levels, idx)
    while breaker_active_levels.size() > 100
        array.shift(breaker_active_levels)
    if breaker_swept_bear
        breaker_pending_bull_sweep_idx := bar_index
        breaker_pending_bull_first_sweep_bar := bar_index
        breaker_pending_bull_extreme := low
        breaker_pending_bull_level := breaker_swept_bear_price
        breaker_pending_bull_level_start_bar := breaker_swept_bear_start_bar
        breaker_pending_bull_label_text := breaker_swept_bear_label
    else if not na(breaker_pending_bull_sweep_idx) and low < breaker_pending_bull_extreme
        breaker_pending_bull_extreme := low
        breaker_pending_bull_sweep_idx := bar_index
    if breaker_swept_bull
        breaker_pending_bear_sweep_idx := bar_index
        breaker_pending_bear_first_sweep_bar := bar_index
        breaker_pending_bear_extreme := high
        breaker_pending_bear_level := breaker_swept_bull_price
        breaker_pending_bear_level_start_bar := breaker_swept_bull_start_bar
        breaker_pending_bear_label_text := breaker_swept_bull_label
    else if not na(breaker_pending_bear_sweep_idx) and high > breaker_pending_bear_extreme
        breaker_pending_bear_extreme := high
        breaker_pending_bear_sweep_idx := bar_index
    if not na(breaker_pending_bull_sweep_idx)
        breaker_bull_sweep_offset = bar_index - breaker_pending_bull_sweep_idx
        [breaker_bull_start_offset, breaker_bull_end_offset] = breakerFindUpCandlesSeries(breaker_bull_sweep_offset)
        if not na(breaker_bull_start_offset)
            [breaker_bull_top, breaker_bull_bottom] = breakerSeriesRange(breaker_bull_start_offset, breaker_bull_end_offset)
            if close > breaker_bull_top and breaker_bull_bottom >= breaker_pending_bull_extreme and breakerSizeFilter(breaker_bull_top, breaker_bull_bottom)
                breaker_bull_start_bar = bar_index - breaker_bull_end_offset
                [breaker_bull_fvg_top, breaker_bull_fvg_bottom, breaker_bull_fvg_left, breaker_bull_fvg_right] = breakerFindBullishFVG(breaker_bull_top, breaker_bull_bottom, breaker_bull_start_bar)
                breaker_bull_has_fvg = not na(breaker_bull_fvg_left)
                if not breaker_require_fvg or breaker_bull_has_fvg
                    breaker_bull_invalidation = breaker_use_sweep_invalidation ? breaker_pending_bull_extreme : breaker_bull_bottom
                    breaker_bull_risk = close - breaker_bull_invalidation
                    if breaker_bull_risk > 0
                        addBreakerSetup(true, breaker_bull_start_offset, breaker_bull_end_offset, breaker_pending_bull_first_sweep_bar, breaker_pending_bull_level_start_bar, breaker_pending_bull_label_text, breaker_bull_top, breaker_bull_bottom, breaker_pending_bull_level, breaker_bull_invalidation, breaker_bull_has_fvg, breaker_bull_fvg_top, breaker_bull_fvg_bottom, breaker_bull_fvg_left, breaker_bull_fvg_right)
                        breaker_pending_bull_sweep_idx := na
                        breaker_pending_bull_first_sweep_bar := na
    if not na(breaker_pending_bear_sweep_idx)
        breaker_bear_sweep_offset = bar_index - breaker_pending_bear_sweep_idx
        [breaker_bear_start_offset, breaker_bear_end_offset] = breakerFindDownCandlesSeries(breaker_bear_sweep_offset)
        if not na(breaker_bear_start_offset)
            [breaker_bear_top, breaker_bear_bottom] = breakerSeriesRange(breaker_bear_start_offset, breaker_bear_end_offset)
            if close < breaker_bear_bottom and breaker_bear_top <= breaker_pending_bear_extreme and breakerSizeFilter(breaker_bear_top, breaker_bear_bottom)
                breaker_bear_start_bar = bar_index - breaker_bear_end_offset
                [breaker_bear_fvg_top, breaker_bear_fvg_bottom, breaker_bear_fvg_left, breaker_bear_fvg_right] = breakerFindBearishFVG(breaker_bear_top, breaker_bear_bottom, breaker_bear_start_bar)
                breaker_bear_has_fvg = not na(breaker_bear_fvg_left)
                if not breaker_require_fvg or breaker_bear_has_fvg
                    breaker_bear_invalidation = breaker_use_sweep_invalidation ? breaker_pending_bear_extreme : breaker_bear_top
                    breaker_bear_risk = breaker_bear_invalidation - close
                    if breaker_bear_risk > 0
                        addBreakerSetup(false, breaker_bear_start_offset, breaker_bear_end_offset, breaker_pending_bear_first_sweep_bar, breaker_pending_bear_level_start_bar, breaker_pending_bear_label_text, breaker_bear_top, breaker_bear_bottom, breaker_pending_bear_level, breaker_bear_invalidation, breaker_bear_has_fvg, breaker_bear_fvg_top, breaker_bear_fvg_bottom, breaker_bear_fvg_left, breaker_bear_fvg_right)
                        breaker_pending_bear_sweep_idx := na
                        breaker_pending_bear_first_sweep_bar := na
    updateBreakerSetups()

alertcondition(enable_alerts and alert_breaker_setup and alerts.longBreaker, "Long Breaker", "Long Breaker setup")
alertcondition(enable_alerts and alert_breaker_setup and alerts.shortBreaker, "Short Breaker", "Short Breaker setup")
