//+------------------------------------------------------------------------------------------------------------+//
//+--- Internal Functions                                                                                   ---+//
//+------------------------------------------------------------------------------------------------------------+//
ValidTimeframe() =>
    if timeframe.in_seconds() <= timeframe.in_seconds(tf_limit)
        true
    else
        false

getAutoFractalHTF() =>
    if ValidTimeframe()
        int tf_sec = timeframe.in_seconds()
        string auto_htf = tf_sec == 60 ? "15" : tf_sec == 180 ? "30" : tf_sec == 300 ? "60" : na
        auto_htf

if htf0.settings.show
    htf0.settings.htf := getAutoFractalHTF()
    htf0.settings.show := not na(htf0.settings.htf)
int htf_ms = not na(htf0.settings.htf) ? timeframe.in_seconds(htf0.settings.htf) * 1000 : 0

DayofWeek(int index) =>
    switch index
        1 => 'M'
        2 => 'T'
        3 => 'W'
        4 => 'T'
        5 => 'F'
        6 => 'S'
        7 => 'S'
        => ''

get_line_style(style) =>
    switch style
        '------' => line.style_dashed
        '······' => line.style_dotted
        => line.style_solid

// Check if current chart symbol matches any from symbol
getCurrentPairIndex() =>
    current_symbol = syminfo.tickerid
    if str.contains(current_symbol, from_pair1) or str.contains(from_pair1, current_symbol)
        1
    else if str.contains(current_symbol, from_pair2) or str.contains(from_pair2, current_symbol)
        2
    else if str.contains(current_symbol, from_pair3) or str.contains(from_pair3, current_symbol)
        3
    else if str.contains(current_symbol, from_pair4) or str.contains(from_pair4, current_symbol)
        4
    else if str.contains(current_symbol, from_pair5) or str.contains(from_pair5, current_symbol)
        5
    else if str.contains(current_symbol, from_pair6) or str.contains(from_pair6, current_symbol)
        6
    else
        0

// Get symbol pairs based on index
getSymbolPairs(index) =>
    if index == 1
        [from_pair1, to_pair1a, to_pair1b, enable_to_pair1b]
    else if index == 2
        [from_pair2, to_pair2a, to_pair2b, enable_to_pair2b]
    else if index == 3
        [from_pair3, to_pair3a, to_pair3b, enable_to_pair3b]
    else if index == 4
        [from_pair4, to_pair4a, to_pair4b, enable_to_pair4b]
    else if index == 5
        [from_pair5, to_pair5a, to_pair5b, enable_to_pair5b]
    else if index == 6
        [from_pair6, to_pair6a, to_pair6b, enable_to_pair6b]
    else
        [na, na, na, false]

// Function to detect divergence between two price arrays
detectDivergence(prev_price1, curr_price1, prev_price2, curr_price2, is_high) =>
    if is_high
        curr_price1 > prev_price1 and curr_price2 < prev_price2 or curr_price1 < prev_price1 and curr_price2 > prev_price2
    else
        curr_price1 < prev_price1 and curr_price2 > prev_price2 or curr_price1 > prev_price1 and curr_price2 < prev_price2

cleanupDrawObjects() =>
    while fmSweepLines.size() > 2
        line.delete(fmSweepLines.shift())

    for tb in tspotBoxes
        box.delete(tb)
    array.clear(tspotBoxes)

    for tc2 in tspotC2Labels
        label.delete(tc2)
    array.clear(tspotC2Labels)

    for tc3 in tspotC3Labels
        label.delete(tc3)
    array.clear(tspotC3Labels)

    for tc4 in tspotC4Labels
        label.delete(tc4)
    array.clear(tspotC4Labels)

    for fpl in fmProjLines
        line.delete(fpl)
    array.clear(fmProjLines)

    for fplb in fmProjLabels
        label.delete(fplb)
    array.clear(fmProjLabels)

    for shl in smtHighLines
        line.delete(shl)
    array.clear(smtHighLines)

    for sll in smtLowLines
        line.delete(sll)
    array.clear(smtLowLines)

HTFName(string HTF) =>
    formatted = HTF

    seconds = timeframe.in_seconds(HTF)
    if seconds < 60
        formatted := str.tostring(seconds) + 's'
        formatted
    else if seconds / 60 < 60
        formatted := str.tostring(seconds / 60) + 'm'
        formatted
    else if seconds / 60 / 60 < 24
        formatted := str.tostring(seconds / 60 / 60) + 'H'
        formatted
    formatted

HTFEnabled() =>
    int enabled = 0
    enabled += htf0.settings.show ? 1 : 0
    enabled += htf1.settings.show ? 1 : 0
    enabled += htf2.settings.show ? 1 : 0
    enabled += htf3.settings.show ? 1 : 0
    enabled

CandleSetHigh(array<Candle> candles, float h) =>
    float _h = h
    if array.size(candles) > 0
        for i = 0 to array.size(candles) - 1 by 1
            Candle c = array.get(candles, i)
            if c.h > _h
                _h := c.h
                _h
    _h

CandleSetLow(array<Candle> candles, float l) =>
    float _l = l
    if array.size(candles) > 0
        for i = 0 to array.size(candles) - 1 by 1
            Candle c = array.get(candles, i)
            if c.l < _l
                _l := c.l
                _l
    _l

CandlesHigh(array<Candle> candles) =>
    h = 0.0
    int cnt = 0
    int last = HTFEnabled()

    if ValidTimeframe()
        h := CandleSetHigh(htf0.candles, h)
        cnt := cnt + 1
    if ValidTimeframe() and cnt < last
        h := CandleSetHigh(htf1.candles, h)
        cnt := cnt + 1
    if ValidTimeframe() and cnt < last
        h := CandleSetHigh(htf2.candles, h)
        cnt := cnt + 1
    if ValidTimeframe() and cnt < last
        h := CandleSetHigh(htf3.candles, h)
        cnt := cnt + 1
    if array.size(candles) > 0
        for i = 0 to array.size(candles) - 1 by 1
            Candle c = array.get(candles, i)
            if c.h > h
                h := c.h
    h

CandlesLow(array<Candle> candles, float h) =>
    l = h
    int cnt = 0
    int last = HTFEnabled()

    if ValidTimeframe()
        l := CandleSetLow(htf0.candles, l)
        cnt := cnt + 1
    if ValidTimeframe() and cnt < last
        l := CandleSetLow(htf1.candles, l)
        cnt := cnt + 1
    if ValidTimeframe() and cnt < last
        l := CandleSetLow(htf2.candles, l)
        cnt := cnt + 1
    if ValidTimeframe() and cnt < last
        l := CandleSetLow(htf3.candles, l)
        cnt := cnt + 1
    if array.size(candles) > 0
        for i = 0 to array.size(candles) - 1 by 1
            Candle c = array.get(candles, i)
            if c.l < l
                l := c.l
    l

method Reorder(CandleSet candleSet, int offset) =>
    size = candleSet.candles.size()

    if size > 0
        for i = size - 1 to 0 by 1
            Candle candle = candleSet.candles.get(i)
            t_buffer = offset + (settings.width + settings.buffer) * (size - i - 1)
            box.set_left(candle.body, bar_index + t_buffer)
            box.set_right(candle.body, bar_index + settings.width + t_buffer)
            line.set_x1(candle.wick_up, bar_index + settings.width / 2 + t_buffer)
            line.set_x2(candle.wick_up, bar_index + settings.width / 2 + t_buffer)
            line.set_x1(candle.wick_down, bar_index + settings.width / 2 + t_buffer)
            line.set_x2(candle.wick_down, bar_index + settings.width / 2 + t_buffer)

            if settings.candle_time == true and (candleSet.settings.htf == '240' or candleSet.settings.htf == '420' or candleSet.settings.htf == 'D')
                if not na(candle.dow_label)
                    candle.dow_label.set_y(candle.l)
                    candle.dow_label.set_x(bar_index + settings.width / 2 + t_buffer)
                    candle.dow_label.set_text(candle.dow)
                else
                    candle.dow_label := label.new(bar_index + settings.width / 2 + t_buffer, candle.l, candle.dow, color = color_transparent, textcolor = settings.dow_color, style = label.style_label_up, size = settings.dow_size, text_font_family = font.family_monospace)
            
            // Check if NEXT candle creates a swing on THIS candle (for drawing swing lines)
            // Include all candles except index 0 (most recent)
            if (show_sweep_lines or show_expansion_lines) and i >= 1
                Candle next_candle = candleSet.candles.get(i - 1)
                // High line Logic
                bool is_potential_high_sweep     = i == 1 and next_candle.h > candle.h
                bool is_confirmed_high_sweep     = i > 1 and next_candle.h > candle.h and next_candle.c < candle.h
                bool is_confirmed_high_expansion = i > 1 and next_candle.h > candle.h and next_candle.c > candle.h
                // Low line Logic
                bool is_potential_low_sweep      = i == 1 and next_candle.l < candle.l
                bool is_confirmed_low_sweep      = i > 1 and next_candle.l < candle.l and next_candle.c > candle.l
                bool is_confirmed_low_expansion  = i > 1 and next_candle.l < candle.l and next_candle.c < candle.l

                // Swing high line (show both potential and confirmed)
                if is_potential_high_sweep or is_confirmed_high_sweep or is_confirmed_high_expansion
                    int next_buffer = offset + (settings.width + settings.buffer) * (size - (i - 1) - 1)
                    int line_start = bar_index + settings.width / 2 + t_buffer
                    int line_end = bar_index + next_buffer
                    string line_style = is_potential_high_sweep ? line.style_dotted : line.style_solid
                    color swing_line_color = next_candle.c < candle.h ? (show_sweep_lines ? sweep_line_color : color_transparent) : (show_expansion_lines ? expansion_line_color : color_transparent)
                    if (candleSet.settings.htf == '240' or candleSet.settings.htf == '420' or candleSet.settings.htf == 'D') and show_ltf_c2_line and is_confirmed_high_sweep
                        if na(candle.ltf_swing_high_line)
                            candle.ltf_swing_high_line := line.new(
                                candle.h_idx, candle.h,
                                next_candle.c_idx, candle.h,
                                xloc=xloc.bar_index,
                                color=ltf_c2_line_color,
                                style=get_line_style(ltf_c2_line_style),
                                width=1) 
                        else
                            line.set_x1(candle.ltf_swing_high_line, candle.h_idx)
                            line.set_y1(candle.ltf_swing_high_line, candle.h)
                            line.set_x2(candle.ltf_swing_high_line, next_candle.c_idx)
                            line.set_y2(candle.ltf_swing_high_line, candle.h)
                            line.set_color(candle.ltf_swing_high_line, ltf_c2_line_color)
                            line.set_style(candle.ltf_swing_high_line, get_line_style(ltf_c2_line_style))
                        // LTF swing high label
                        if na(candle.ltf_swing_high_label)
                            candle.ltf_swing_high_label := label.new(
                                next_candle.c_idx,
                                candle.h,
                                HTFName(candleSet.settings.htf),
                                xloc=xloc.bar_index,
                                style=label.style_label_down,
                                color=color_transparent,
                                textcolor=ltf_c2_line_color,
                                size=size.tiny)
                        else
                            label.set_x(candle.ltf_swing_high_label, next_candle.c_idx)
                            label.set_y(candle.ltf_swing_high_label, candle.h)
                            label.set_color(candle.ltf_swing_high_label, color_transparent)
                            label.set_textcolor(candle.ltf_swing_high_label, ltf_c2_line_color)
                            label.set_style(candle.ltf_swing_high_label, label.style_label_down)

                    if na(candle.swing_high_line)
                        candle.swing_high_line := line.new(line_start, candle.h, line_end, candle.h, color=swing_line_color, width=1, style=line_style)
                    else
                        line.set_x1(candle.swing_high_line, line_start)
                        line.set_y1(candle.swing_high_line, candle.h)
                        line.set_x2(candle.swing_high_line, line_end)
                        line.set_y2(candle.swing_high_line, candle.h)
                        line.set_color(candle.swing_high_line, swing_line_color)
                        line.set_style(candle.swing_high_line, line_style)
                else
                    // Delete only if confirmed closed candle invalidated the swing
                    if i > 1 and not na(candle.swing_high_line)
                        line.delete(candle.swing_high_line)
                        candle.swing_high_line := na
                    if i > 1 and not na(candle.ltf_swing_high_line)
                        line.delete(candle.ltf_swing_high_line)
                        candle.ltf_swing_high_line := na
                    if i > 1 and not na(candle.ltf_swing_high_label)
                        label.delete(candle.ltf_swing_high_label)
                        candle.ltf_swing_high_label := na

                // Swing low line (show both potential and confirmed)
                if is_potential_low_sweep or is_confirmed_low_sweep or is_confirmed_low_expansion
                    int next_buffer = offset + (settings.width + settings.buffer) * (size - (i - 1) - 1)
                    int line_start = bar_index + settings.width / 2 + t_buffer
                    int line_end = bar_index + next_buffer
                    string line_style = is_potential_low_sweep ? line.style_dotted : line.style_solid
                    color swing_line_color = next_candle.c > candle.l ? (show_sweep_lines ? sweep_line_color : color_transparent) : (show_expansion_lines ? expansion_line_color : color_transparent)
                    if (candleSet.settings.htf == '240' or candleSet.settings.htf == '420' or candleSet.settings.htf == 'D') and show_ltf_c2_line and is_confirmed_low_sweep
                        if na(candle.ltf_swing_low_line)
                            candle.ltf_swing_low_line := line.new(
                                candle.l_idx, candle.l,
                                next_candle.c_idx, candle.l,
                                xloc=xloc.bar_index,
                                color=ltf_c2_line_color,
                                style=get_line_style(ltf_c2_line_style),
                                width=1)
                        else 
                            line.set_x1(candle.ltf_swing_low_line, candle.l_idx)
                            line.set_y1(candle.ltf_swing_low_line, candle.l)
                            line.set_x2(candle.ltf_swing_low_line, next_candle.c_idx)
                            line.set_y2(candle.ltf_swing_low_line, candle.l)
                            line.set_color(candle.ltf_swing_low_line, ltf_c2_line_color)
                            line.set_style(candle.ltf_swing_low_line, get_line_style(ltf_c2_line_style))
                        // LTF swing low label
                        if na(candle.ltf_swing_low_label)
                            candle.ltf_swing_low_label := label.new(
                                next_candle.c_idx,
                                candle.l,
                                HTFName(candleSet.settings.htf),
                                xloc=xloc.bar_index,
                                style=label.style_label_up,
                                color=color_transparent,
                                textcolor=ltf_c2_line_color,
                                size=size.tiny)
                        else
                            label.set_x(candle.ltf_swing_low_label, next_candle.c_idx)
                            label.set_y(candle.ltf_swing_low_label, candle.l)
                            label.set_color(candle.ltf_swing_low_label, color_transparent)
                            label.set_textcolor(candle.ltf_swing_low_label, ltf_c2_line_color)
                            label.set_style(candle.ltf_swing_low_label, label.style_label_up)

                    if na(candle.swing_low_line)
                        candle.swing_low_line := line.new(line_start, candle.l, line_end, candle.l, color=swing_line_color, width=1, style=line_style)
                    else
                        line.set_x1(candle.swing_low_line, line_start)
                        line.set_y1(candle.swing_low_line, candle.l)
                        line.set_x2(candle.swing_low_line, line_end)
                        line.set_y2(candle.swing_low_line, candle.l)
                        line.set_color(candle.swing_low_line, swing_line_color)
                        line.set_style(candle.swing_low_line, line_style)
                else
                    // Delete only if confirmed closed candle invalidated the swing
                    if i > 1 and not na(candle.swing_low_line)
                        line.delete(candle.swing_low_line)
                        candle.swing_low_line := na
                    if i > 1 and not na(candle.ltf_swing_low_line)
                        line.delete(candle.ltf_swing_low_line)
                        candle.ltf_swing_low_line := na
                    if i > 1 and not na(candle.ltf_swing_low_label)
                        label.delete(candle.ltf_swing_low_label)
                        candle.ltf_swing_low_label := na

            // Draw EQ line from each closed candle to the next candle
            if show_eq_line and  i == 1 and size >= 2
                // This candle's equilibrium (midpoint of high and low)
                float eq_price = (candle.h + candle.l) / 2
                
                // Line from right edge of this candle to left edge of next candle (toward index 0)
                int next_buffer = offset + (settings.width + settings.buffer) * (size - (i - 1) - 1)
                int line_start_x = bar_index + settings.width + t_buffer
                int line_end_x = bar_index + next_buffer + 1
                
                if na(candle.eq_line)
                    candle.eq_line := line.new(line_start_x, eq_price, line_end_x, eq_price, color=eq_line_color, width=1, style=get_line_style(eq_line_style))
                else
                    line.set_x1(candle.eq_line, line_start_x)
                    line.set_y1(candle.eq_line, eq_price)
                    line.set_x2(candle.eq_line, line_end_x)
                    line.set_y2(candle.eq_line, eq_price)
            else if show_eq_line and i > 1
                // Delete EQ line from older candles
                if not na(candle.eq_line)
                    line.delete(candle.eq_line)
                    candle.eq_line := na
            
            // Clean up divergence lines and flags from candles that are not at index 1
            if i != 1
                if not na(candle.div_high_line)
                    line.delete(candle.div_high_line)
                    candle.div_high_line := na
                if not na(candle.div_low_line)
                    line.delete(candle.div_low_line)
                    candle.div_low_line := na

    // SMT / PSP logic for the visible HTF candle sequence
    if size >= 2 and barstate.islast
        current_pair_index = getCurrentPairIndex()

        if current_pair_index > 0
            [from_symbol, to_symbol_a, to_symbol_b, enable_b] = getSymbolPairs(current_pair_index)
            check_symbol_b = enable_b and to_symbol_a != to_symbol_b and to_symbol_b != ""

            [from_h0, from_h1, from_h2, from_h3, from_h4, from_h5,
             from_l0, from_l1, from_l2, from_l3, from_l4, from_l5] = request.security(
                from_symbol,
                candleSet.settings.htf,
                [high, high[1], high[2], high[3], high[4], high[5],
                 low, low[1], low[2], low[3], low[4], low[5]],
                barmerge.gaps_off,
                barmerge.lookahead_off,
                ignore_invalid_symbol = true)

            [to_a_h0, to_a_h1, to_a_h2, to_a_h3, to_a_h4, to_a_h5,
             to_a_l0, to_a_l1, to_a_l2, to_a_l3, to_a_l4, to_a_l5] = request.security(
                to_symbol_a,
                candleSet.settings.htf,
                [high, high[1], high[2], high[3], high[4], high[5],
                 low, low[1], low[2], low[3], low[4], low[5]],
                barmerge.gaps_off,
                barmerge.lookahead_off,
                ignore_invalid_symbol = true)

            [to_b_h0, to_b_h1, to_b_h2, to_b_h3, to_b_h4, to_b_h5,
             to_b_l0, to_b_l1, to_b_l2, to_b_l3, to_b_l4, to_b_l5] = request.security(
                to_symbol_b,
                candleSet.settings.htf,
                [high, high[1], high[2], high[3], high[4], high[5],
                 low, low[1], low[2], low[3], low[4], low[5]],
                barmerge.gaps_off,
                barmerge.lookahead_off,
                ignore_invalid_symbol = true)

            int pair_count = math.min(size - 1, math.min(candleSet.settings.max_display - 1, 20))
            for pair_idx = 1 to pair_count by 1
                Candle prev_candle = candleSet.candles.get(pair_idx - 1)
                Candle curr_candle = candleSet.candles.get(pair_idx)
                int prev_x = bar_index + settings.width / 2 + offset + (settings.width + settings.buffer) * (size - pair_idx)
                int curr_x = bar_index + settings.width / 2 + offset + (settings.width + settings.buffer) * (size - pair_idx - 1)

                bool data_valid_a = not na(from_h0) and not na(from_h1) and not na(from_l0) and not na(from_l1) and not na(to_a_h0) and not na(to_a_h1) and not na(to_a_l0) and not na(to_a_l1)
                bool data_valid_b = check_symbol_b and not na(to_b_h0) and not na(to_b_h1) and not na(to_b_l0) and not na(to_b_l1)

                bool high_div_a = data_valid_a and detectDivergence(array.get(array.from(from_h0, from_h1, from_h2, from_h3, from_h4, from_h5), pair_idx - 1), array.get(array.from(from_h0, from_h1, from_h2, from_h3, from_h4, from_h5), pair_idx), array.get(array.from(to_a_h0, to_a_h1, to_a_h2, to_a_h3, to_a_h4, to_a_h5), pair_idx - 1), array.get(array.from(to_a_h0, to_a_h1, to_a_h2, to_a_h3, to_a_h4, to_a_h5), pair_idx), true)
                bool low_div_a = data_valid_a and detectDivergence(array.get(array.from(from_l0, from_l1, from_l2, from_l3, from_l4, from_l5), pair_idx - 1), array.get(array.from(from_l0, from_l1, from_l2, from_l3, from_l4, from_l5), pair_idx), array.get(array.from(to_a_l0, to_a_l1, to_a_l2, to_a_l3, to_a_l4, to_a_l5), pair_idx - 1), array.get(array.from(to_a_l0, to_a_l1, to_a_l2, to_a_l3, to_a_l4, to_a_l5), pair_idx), false)
                bool high_div_b = data_valid_b and detectDivergence(array.get(array.from(from_h0, from_h1, from_h2, from_h3, from_h4, from_h5), pair_idx - 1), array.get(array.from(from_h0, from_h1, from_h2, from_h3, from_h4, from_h5), pair_idx), array.get(array.from(to_b_h0, to_b_h1, to_b_h2, to_b_h3, to_b_h4, to_b_h5), pair_idx - 1), array.get(array.from(to_b_h0, to_b_h1, to_b_h2, to_b_h3, to_b_h4, to_b_h5), pair_idx), true)
                bool low_div_b = data_valid_b and detectDivergence(array.get(array.from(from_l0, from_l1, from_l2, from_l3, from_l4, from_l5), pair_idx - 1), array.get(array.from(from_l0, from_l1, from_l2, from_l3, from_l4, from_l5), pair_idx), array.get(array.from(to_b_l0, to_b_l1, to_b_l2, to_b_l3, to_b_l4, to_b_l5), pair_idx - 1), array.get(array.from(to_b_l0, to_b_l1, to_b_l2, to_b_l3, to_b_l4, to_b_l5), pair_idx), false)

                int high_div_count = (high_div_a ? 1 : 0) + (high_div_b ? 1 : 0)
                int low_div_count = (low_div_a ? 1 : 0) + (low_div_b ? 1 : 0)

                if show_smt
                    if high_div_count > 0
                        int line_width = high_div_count > 1 ? smt_line_width_2 : smt_line_width_1
                        if na(curr_candle.div_high_line)
                            curr_candle.div_high_line := line.new(prev_x, prev_candle.h, curr_x, curr_candle.h, color=smt_high_color, width=line_width, style=line.style_solid)
                        else
                            line.set_x1(curr_candle.div_high_line, prev_x)
                            line.set_y1(curr_candle.div_high_line, prev_candle.h)
                            line.set_x2(curr_candle.div_high_line, curr_x)
                            line.set_y2(curr_candle.div_high_line, curr_candle.h)
                            line.set_width(curr_candle.div_high_line, line_width)
                            line.set_style(curr_candle.div_high_line, line.style_solid)
                    else if not na(curr_candle.div_high_line)
                        line.delete(curr_candle.div_high_line)
                        curr_candle.div_high_line := na

                    if low_div_count > 0
                        int line_width = low_div_count > 1 ? smt_line_width_2 : smt_line_width_1
                        if na(curr_candle.div_low_line)
                            curr_candle.div_low_line := line.new(prev_x, prev_candle.l, curr_x, curr_candle.l, color=smt_low_color, width=line_width, style=line.style_solid)
                        else
                            line.set_x1(curr_candle.div_low_line, prev_x)
                            line.set_y1(curr_candle.div_low_line, prev_candle.l)
                            line.set_x2(curr_candle.div_low_line, curr_x)
                            line.set_y2(curr_candle.div_low_line, curr_candle.l)
                            line.set_width(curr_candle.div_low_line, line_width)
                            line.set_style(curr_candle.div_low_line, line.style_solid)
                    else if not na(curr_candle.div_low_line)
                        line.delete(curr_candle.div_low_line)
                        curr_candle.div_low_line := na

                if show_smt
                    if high_div_a
                        line smt_high_line = line.new(prev_x, prev_candle.h, curr_x, curr_candle.h, color=smt_high_color, width=smt_line_width_1, style=line.style_solid)
                        array.push(smtHighLines, smt_high_line)
                    if high_div_b
                        line smt_high_line = line.new(prev_x, prev_candle.h, curr_x, curr_candle.h, color=smt_high_color, width=smt_line_width_2, style=line.style_solid)
                        array.push(smtHighLines, smt_high_line)

                    if low_div_a
                        line smt_low_line = line.new(prev_x, prev_candle.l, curr_x, curr_candle.l, color=smt_low_color, width=smt_line_width_1, style=line.style_solid)
                        array.push(smtLowLines, smt_low_line)
                    if low_div_b
                        line smt_low_line = line.new(prev_x, prev_candle.l, curr_x, curr_candle.l, color=smt_low_color, width=smt_line_width_2, style=line.style_solid)
                        array.push(smtLowLines, smt_low_line)

    top = 0.0
    bottom = 0.0

    if settings.label_alignment == 'Align'
        top := CandlesHigh(candleSet.candles)
        bottom := CandlesLow(candleSet.candles, top)
    if settings.label_alignment == 'Follow Candles'
        top := CandleSetHigh(candleSet.candles, 0)
        bottom := CandleSetLow(candleSet.candles, top)

    left = bar_index + offset + (settings.width + settings.buffer) * (size - 1) / 2

    // Always update labels on last bar for visibility after resume
    if settings.htf_label_show and barstate.islast
        string lblt = HTFName(candleSet.settings.htf)
        
        string lbll = lblt
        if settings.candle_time
            lblt := lblt + '\n'

        if settings.label_position == 'Both' or settings.label_position == 'Top'
            
            if not na(candleSet.tfNameTop)
                candleSet.tfNameTop.set_xy(left, top)
                candleSet.tfNameTop.set_text(lblt)  // Update text to include swing icons
            else
                candleSet.tfNameTop := label.new(left, top, lblt, color = color_transparent, textcolor = settings.htf_label_color, style = label.style_label_down, size = settings.htf_label_size, text_font_family = font.family_monospace)
            
        if settings.label_position == 'Both' or settings.label_position == 'Bottom'
            if not na(candleSet.tfNameBottom)
                candleSet.tfNameBottom.set_xy(left, bottom)
                candleSet.tfNameBottom.set_text(lbll)  // Update text to include swing icons
            else
                candleSet.tfNameBottom := label.new(left, bottom, lbll, color = color_transparent, textcolor = settings.htf_label_color, style = label.style_label_up, size = settings.htf_label_size, text_font_family = font.family_monospace)
            
    candleSet

// Alerts for C2 Closure
AlertC2Closure(CandleSet candleSet) => 
    size = candleSet.candles.size()
    if candleSet.settings.show and enable_alert_c2_closure and size >= 3
        Candle c1 = array.get(candleSet.candles, 2)
        Candle c2 = array.get(candleSet.candles, 1)
        bool highSweep = c2.h > c1.h and c2.c <= c1.h
        bool lowSweep  = c2.l < c1.l and c2.c >= c1.l

        string tf_name = HTFName(candleSet.settings.htf)
        if highSweep
            alert(tf_name + " - " + c2.dow + " ▼ - Bearish C2 Closure" )

        if lowSweep
            alert(tf_name + " - " + c2.dow + " ▲ - Bullish C2 Closure")

method Monitor(CandleSet candleSet) =>
    HTFBarTime = time(candleSet.settings.htf, session_timezone)
    isNewHTFCandle = ta.change(HTFBarTime) > 0

    if isNewHTFCandle
        Candle candle = Candle.new()
        candle.o := open
        candle.c := close
        candle.h := high
        candle.l := low
        candle.o_time := time

        candle.c_idx := bar_index
        candle.h_idx := bar_index
        candle.l_idx := bar_index
        string candleHourNy = str.format_time(candle.o_time, 'HH', session_timezone)
        candle.dow := switch
            candleSet.settings.htf == 'D' => DayofWeek(dayofweek(time, session_timezone))
            candleSet.settings.htf == '420' => candleHourNy == '18' or candleHourNy == '17' ? 'A' : candleHourNy == '01' or candleHourNy == '00' ? 'L' : candleHourNy == '08' or candleHourNy == '07' ? 'N' : ''
            => candleHourNy

        bull = candle.c > candle.o

        candle.body := box.new(bar_index, math.max(candle.o, candle.c), bar_index + 2, math.min(candle.o, candle.c), bull ? settings.border : settings.border, 1, bgcolor = bull ? settings.bull_body : settings.bear_body)
        candle.wick_up := line.new(bar_index + 1, candle.h, bar_index, math.max(candle.o, candle.c), color = bull ? settings.border : settings.border)
        candle.wick_down := line.new(bar_index + 1, math.min(candle.o, candle.c), bar_index, candle.l, color = bull ? settings.border : settings.border)

        candleSet.candles.unshift(candle)

        if candleSet.candles.size() > candleSet.settings.max_display
            Candle delCandle = array.pop(candleSet.candles)
            box.delete(delCandle.body)
            line.delete(delCandle.wick_up)
            line.delete(delCandle.wick_down)
            if not na(delCandle.dow_label)
                label.delete(delCandle.dow_label)
            if not na(delCandle.swing_high_line)
                line.delete(delCandle.swing_high_line)
            if not na(delCandle.swing_low_line)
                line.delete(delCandle.swing_low_line)
            if not na(delCandle.ltf_swing_high_line)
                line.delete(delCandle.ltf_swing_high_line)
            if not na(delCandle.ltf_swing_low_line)
                line.delete(delCandle.ltf_swing_low_line)
            if not na(delCandle.ltf_swing_high_label)
                label.delete(delCandle.ltf_swing_high_label)
            if not na(delCandle.ltf_swing_low_label)
                label.delete(delCandle.ltf_swing_low_label)
            if not na(delCandle.eq_line)
                line.delete(delCandle.eq_line)
            if not na(delCandle.div_high_line)
                line.delete(delCandle.div_high_line)
            if not na(delCandle.div_low_line)
                line.delete(delCandle.div_low_line)

        // Alerts for C2 Closure
        if enable_alerts
            AlertC2Closure(candleSet)
    candleSet

method Update(CandleSet candleSet, int offset) =>
    if candleSet.candles.size() > 0
        Candle candle = candleSet.candles.first()
        candle.h_idx := high > candle.h ? bar_index : candle.h_idx
        candle.h := high > candle.h ? high : candle.h
        candle.l_idx := low < candle.l ? bar_index : candle.l_idx
        candle.l := low < candle.l ? low : candle.l
        candle.c := close
        candle.c_idx := bar_index

        bull = candle.c > candle.o

        box.set_top(candle.body, candle.o)
        box.set_bottom(candle.body, candle.c)
        box.set_bgcolor(candle.body, bull ? settings.bull_body : settings.bear_body)
        box.set_border_color(candle.body, bull ? settings.border : settings.border)
        line.set_color(candle.wick_up, bull ? settings.border : settings.border)
        line.set_color(candle.wick_down, bull ? settings.border : settings.border)
        line.set_y1(candle.wick_up, candle.h)
        line.set_y2(candle.wick_up, math.max(candle.o, candle.c))
        line.set_y1(candle.wick_down, candle.l)
        line.set_y2(candle.wick_down, math.min(candle.o, candle.c))

        // Always reorder candles to ensure visibility even after resume/refresh
        candleSet.Reorder(offset)
    candleSet
// ============================================================
// FRACTAL MODEL HELPERS — ported from Fractal-Model-Silent.pine
// ============================================================
f_mid_time(int t) =>
    t + math.round(htf_ms / 2)

f_opposite_model_at_index(bool current_bearish, array<Candle> _candleArray, int idx) =>
    bool found = false
    int ref_idx = idx + 1
    if idx >= 0 and ref_idx < array.size(_candleArray)
        Candle refC = array.get(_candleArray, ref_idx)
        Candle curC = array.get(_candleArray, idx)
        found := current_bearish ? (curC.l < refC.l and curC.c > refC.l) : (curC.h > refC.h and curC.c < refC.h)
    found

f_fractal_label(int x, float y, string txt, color txt_col, array<label> _arr) =>
    array.push(_arr, label.new(x, y, txt, xloc=xloc.bar_time, style=label.style_label_center, color=color_transparent, textcolor=txt_col, size=size.small))

f_draw_tspot(bool bearish, int src_t, float src_h, float src_l, float src_c) =>
    if show_tspot and not na(src_t) and not na(src_h) and not na(src_l) and not na(src_c)
        int x1 = src_t + htf_ms
        int x2 = src_t + htf_ms * 2
        float top = na
        float bot = na
        if bearish
            top := (src_h + src_c) / 2.0
            bot := src_c
        else
            top := src_c
            bot := (src_c + src_l) / 2.0
        if not na(top) and not na(bot) and top != bot
            color box_col = bearish ? tspot_bear_color : tspot_bull_color
            array.push(tspotBoxes, box.new(x1, math.max(top, bot), x2, math.min(top, bot), xloc=xloc.bar_time, bgcolor=box_col, border_color=na, border_width=1))
            
f_draw_projection_label(int x, float y, string txt) =>
    array.push(fmProjLabels, label.new(x, y, txt, xloc=xloc.bar_time, style=label.style_label_left, color=color_transparent, textcolor=color.new(#787b86, 0), size=fm_projection_size))

f_projection_structure_anchor(bool bearish, int c2_start_t, int c2_end_t, float c2_extreme) =>
    float anchor = na
    int anchor_t = na
    int extreme_t = na
    int search_start_t = c2_start_t - htf_ms

    for k = 0 to 5000
        int kt = time[k]
        if na(kt)
            break
        if kt < c2_start_t
            break
        if kt >= c2_start_t and kt < c2_end_t
            bool is_extreme_bar = bearish ? high[k] >= c2_extreme : low[k] <= c2_extreme
            if is_extreme_bar
                extreme_t := kt
                break

    if not na(extreme_t)
        for k = 1 to 4999
            int kt = time[k]
            if na(kt) or na(time[k + 1]) or na(time[k - 1])
                break
            if kt < search_start_t
                break
            if kt >= search_start_t and kt < extreme_t
                bool swing_low = low[k] < low[k + 1] and low[k] < low[k - 1]
                bool swing_high = high[k] > high[k + 1] and high[k] > high[k - 1]
                if bearish and swing_low
                    anchor := low[k]
                    anchor_t := kt
                    break
                if not bearish and swing_high
                    anchor := high[k]
                    anchor_t := kt
                    break

    [anchor, anchor_t, extreme_t]

f_draw_projections(bool bearish, int anchor_t, int extreme_t, float c2_extreme, float structure_anchor) =>
    if show_fm_projections and not na(c2_extreme) and not na(structure_anchor) and not na(anchor_t) and not na(extreme_t)
        string[] parts = str.split(fm_projection_levels, ",")
        int count = array.size(parts)
        if count > 0
            float proj_range = math.abs(c2_extreme - structure_anchor)
            int marker_x1 = math.min(anchor_t, extreme_t)
            int marker_x2 = math.max(anchor_t, extreme_t)
            if marker_x1 == marker_x2
                marker_x2 += timeframe.in_seconds() * 1000
            for pi = 0 to count - 1
                string raw = str.trim(array.get(parts, pi))
                float lvl = str.tonumber(raw)
                if not na(lvl)
                    float price = lvl == 1 ? c2_extreme : lvl == 0 ? structure_anchor : bearish ? structure_anchor - proj_range * math.abs(lvl) : structure_anchor + proj_range * math.abs(lvl)
                    array.push(fmProjLines, line.new(marker_x1, price, marker_x2, price, xloc=xloc.bar_time, color=color.new(#787b86, 0), width=1, style=line.style_solid))
                    f_draw_projection_label(marker_x2, price, raw)

// Draws Fractal Dividers 
drawFractalDivider(_enabled, _tf, _dividerArray, max_display) =>
    if _enabled and timeframe.change(_tf)
        divider = line.new(
            bar_index, low,
            bar_index, high,
            xloc=xloc.bar_index,
            extend=extend.both,
            color=divider_color,
            width=1,
            style=line.style_solid)
        array.push(_dividerArray, divider)
        while array.size(_dividerArray) > max_display
            line.delete(array.shift(_dividerArray))
  
// Draw Fractal Models (C2, C3, C4 Labels, T-Spot, Sweep Lines)
drawFractalModel(_enabled, _candleArray) =>
    size = array.size(_candleArray)
    int setups_drawn = 0
    if _enabled
        for c2_idx = 1 to size - 2
            if setups_drawn >= 1
                break

            int c1_idx = c2_idx + 1
            int c3_idx = c2_idx - 1
            int c4_idx = c2_idx - 2

            Candle c1 = array.get(_candleArray, c1_idx)
            Candle c2 = array.get(_candleArray, c2_idx)
            Candle c3 = c3_idx >= 0 ? array.get(_candleArray, c3_idx) : na
            Candle c4 = c4_idx >= 0 ? array.get(_candleArray, c4_idx) : na

            bool data_ok = not na(c1.h) and not na(c1.l) and not na(c1.o_time) and not na(c2.o) and not na(c2.h) and not na(c2.l) and not na(c2.c) and not na(c2.o_time)
            if not data_ok
                continue

            bool bear_setup = c2.h > c1.h and c2.c <= c1.h
            bool bull_setup = c2.l < c1.l and c2.c >= c1.l
            int dir = bull_setup ? 1 : bear_setup ? -1 : 0
            if dir == 0
                continue

            bool bearish = dir == -1

            bool fail_c3 = false
            bool fail_c4 = false
            if c3_idx >= 0
                bool level_fail_c3 = bearish ? c3.h > c2.h : c3.l < c2.l
                bool opposite_fail_c3 = c3_idx >= 1 ? f_opposite_model_at_index(bearish, _candleArray, c3_idx) : false
                fail_c3 := level_fail_c3 or opposite_fail_c3
            if not fail_c3 and c4_idx >= 0 and c3_idx >= 0
                bool level_fail_c4 = bearish ? c4.h > c3.h : c4.l < c3.l
                bool opposite_fail_c4 = c4_idx >= 1 ? f_opposite_model_at_index(bearish, _candleArray, c4_idx) : false
                fail_c4 := level_fail_c4 or opposite_fail_c4

            color state_col = fail_c3 ? failed_color : fail_c4 ? failed_color : valid_color
            bool show_follow_through = not fail_c3

            // C1 liquidity sweep line — drawn across real chart history (C1 extreme bar to C2 close bar)
            float sweep_price = bearish ? c1.h : c1.l
            int sweep_start_idx = bearish ? c1.h_idx : c1.l_idx
            if show_ltf_sweep and not fail_c3 and not fail_c4
                array.push(fmSweepLines, line.new(sweep_start_idx, sweep_price, c2.c_idx, sweep_price, xloc=xloc.bar_index, color=ltf_sweep_color, width=1, style=line.style_solid))

            if not fail_c3 and not fail_c4
                // Structure-anchor projections (independent of the CISD-based projection system)
                int c2_end = c2.o_time + htf_ms
                float c2_projection_anchor = bearish ? c2.h : c2.l
                [structure_anchor, anchor_t, extreme_t] = f_projection_structure_anchor(bearish, c2.o_time, c2_end, c2_projection_anchor)
                f_draw_projections(bearish, anchor_t, extreme_t, c2_projection_anchor, structure_anchor)
                // T-Spot
                f_draw_tspot(bearish, c2.o_time, c2.h, c2.l, c2.c)
                if show_follow_through and c3_idx >= 1
                    f_draw_tspot(bearish, c3.o_time, c3.h, c3.l, c3.c)
                if show_follow_through and c4_idx >= 1
                    f_draw_tspot(bearish, c4.o_time, c4.h, c4.l, c4.c)
                // C2, C3, C4 Labels
                if show_c2
                    f_fractal_label(f_mid_time(c2.o_time), bearish ? c2.h : c2.l, "C2", state_col, tspotC2Labels)
                if show_follow_through and show_c3 and c3_idx >= 0
                    f_fractal_label(f_mid_time(c3.o_time), bearish ? c3.h : c3.l, "C3", state_col, tspotC3Labels)
                if show_follow_through and show_c4 and c4_idx >= 0
                    f_fractal_label(f_mid_time(c4.o_time), bearish ? c4.h : c4.l, "C4", state_col, tspotC4Labels)

            setups_drawn += 1

// Draws Session Dividers 
DrawSessionDividers() =>
    [range_high_7h, range_low_7h] = request.security(
        syminfo.tickerid, "420",
        [math.max(high, math.max(high[1], math.max(high[2], high[3]))), math.min(low, math.min(low[1], math.min(low[2], low[3])))],
        barmerge.gaps_off, barmerge.lookahead_off
    )

    int htf_time = time("420", session_timezone)
    bool is_new_7h = ta.change(htf_time) > 0
    int htf_open_hour = hour(htf_time, session_timezone)

    // Dynamic anchor for 7H cycle: auto-picks 17 or 18 when observed.
    var int asia_anchor_hour = 18
    if is_new_7h and (htf_open_hour == 17 or htf_open_hour == 18)
        asia_anchor_hour := htf_open_hour

    int london_hour = (asia_anchor_hour + 7) % 24
    int newyork_hour = (asia_anchor_hour + 14) % 24

    bool asia_open = is_new_7h and htf_open_hour == asia_anchor_hour
    bool london_open = is_new_7h and htf_open_hour == london_hour
    bool newyork_open = is_new_7h and htf_open_hour == newyork_hour

    bool session_open = asia_open or london_open or newyork_open
    string session_long_name = asia_open ? "Asia" : london_open ? "London" : "New York"
    string session_short_name = asia_open ? "A" : london_open ? "L" : "N"
    string session_name = session_label == 'Short' ? session_short_name : session_label == 'Long' ? session_long_name : ''
    if session_open and not na(range_high_7h) and not na(range_low_7h)
        line session_line = line.new(bar_index, range_high_7h, bar_index, range_low_7h, xloc=xloc.bar_index, extend=extend.none, color=session_line_color, width=1, style=get_line_style(session_line_style))
        label session_label = label.new(bar_index, range_high_7h, session_name, xloc=xloc.bar_index, style=label.style_label_down, color=color_transparent, textcolor=color.new(#000000, 40), size=session_label_size, text_font_family=font.family_monospace)
        array.push(session_vertical_lines, session_line)
        array.push(session_vertical_labels, session_label)

    while array.size(session_vertical_lines) > 3
        line.delete(array.shift(session_vertical_lines))
        label.delete(array.shift(session_vertical_labels))

    if array.size(session_vertical_lines) > 0
        for i = 0 to array.size(session_vertical_lines) - 1
            line session_line = array.get(session_vertical_lines, i)
            label session_label = array.get(session_vertical_labels, i)
            line.set_y1(session_line, range_high_7h)
            line.set_y2(session_line, range_low_7h)
            label.set_y(session_label, range_high_7h)

// Draws HTF Info Table
HTFInfoTable(CandleSet htf1, CandleSet htf2, CandleSet htf3) =>
    // Calculate number of active HTFs
    array<CandleSet> active_htfs = array.new<CandleSet>()
    if htf1.settings.show
        array.push(active_htfs, htf1)
    if htf2.settings.show
        array.push(active_htfs, htf2)
    if htf3.settings.show
        array.push(active_htfs, htf3)
    
    // Calculate rows: 1 header + enabled data rows
    int num_data_rows = 0
    if show_c2_row 
        num_data_rows += 1
    
    int num_cols = array.size(active_htfs) + 1  // +1 for row label column
    int num_rows = num_data_rows + (show_timeframe_row ? 1 : 0)  // +1 for timeframe header row
    
    var table htf_info_table = table.new(table_position_value, columns=num_cols, rows=num_rows, border_width=1, frame_width=1)
    
    // Use custom table colors from settings
    color header_bg = table_header_bg
    color header_text = table_header_text
    color label_bg = table_label_bg
    color label_text = table_label_text
    color data_bg = table_cell_bg
    color data_text = table_cell_text
    
    // Populate table
    if num_cols > 1 and num_rows > 0
        int row = 0
        
        // Header row - Timeframes
        if show_timeframe_row
            table.cell(htf_info_table, 0, row, "", bgcolor=header_bg, text_color=header_text, text_size=table_size)
            for col = 0 to array.size(active_htfs) - 1
                CandleSet htf = array.get(active_htfs, col)
                string tf_name = HTFName(htf.settings.htf)
                table.cell(htf_info_table, col + 1, row, tf_name, bgcolor=header_bg, text_color=header_text, text_size=table_size, text_font_family=font.family_monospace)
            row += 1
        
        // Body row - C2 Closures
        if show_c2_row 
            table.cell(htf_info_table, 0, row, "C2", bgcolor=label_bg, text_color=label_text, text_size=table_size, text_font_family=font.family_monospace)
            for col = 0 to array.size(active_htfs) - 1
                CandleSet htf = array.get(active_htfs, col)
                string c2_text = na
                color c2_bg = data_bg
                int size = htf.candles.size()
                for i = 1 to size - 2
                    int c2_idx = size - 1 - i
                    int c1_idx = c2_idx + 1

                    Candle c1 = htf.candles.get(c1_idx)
                    Candle c2 = htf.candles.get(c2_idx)

                    bool confirmed_c2_high = c2.h > c1.h and c2.c <= c1.h
                    bool confirmed_c2_low  = c2.l < c1.l and c2.c >= c1.l
                    string c2_candle_time = c2.dow
                    // Build text with triangles
                    if confirmed_c2_high and confirmed_c2_low
                        c2_text := c2_text + c2_candle_time + " ▼▲ "
                        c2_bg := both_c2_color
                    else if confirmed_c2_high
                        c2_text := c2_text + c2_candle_time + " ▼ "
                        c2_bg := bear_c2_color
                    else if confirmed_c2_low
                        c2_text := c2_text + c2_candle_time + " ▲ "
                        c2_bg := bull_c2_color
                        
                table.cell(htf_info_table, col + 1, row, not na(c2_text) ? c2_text : " - ", bgcolor=c2_bg, text_color=data_text, text_size=table_size, text_font_family=font.family_monospace)
            row += 1
//----------------------------- Main Calls --------------------------------- //
// Cleanup draw objects on last bar to prevent memory leaks
if barstate.islast
    cleanupDrawObjects()

// Draw HTF Candles (if enabled)
int cnt = 0
int last = HTFEnabled()
int offset = settings.offset
if htf0.settings.show and ValidTimeframe()
    htf0.Monitor().Update(offset)
    cnt := cnt + 1
    offset := offset + (cnt > 0 ? htf0.candles.size() * settings.width + (htf0.candles.size() > 0 ? (htf0.candles.size() - 1) * settings.buffer : 0) + settings.htf_buffer : 0)
    offset
if htf1.settings.show and ValidTimeframe() and cnt < last
    htf1.Monitor().Update(offset)
    cnt := cnt + 1
    offset := offset + (cnt > 0 ? htf1.candles.size() * settings.width + (htf1.candles.size() > 0 ? (htf1.candles.size() - 1) * settings.buffer : 0) + settings.htf_buffer : 0)
    offset
if htf2.settings.show and ValidTimeframe() and cnt < last
    htf2.Monitor().Update(offset)
    cnt := cnt + 1
    offset := offset + (cnt > 0 ? htf2.candles.size() * settings.width + (htf2.candles.size() > 0 ? (htf2.candles.size() - 1) * settings.buffer : 0) + settings.htf_buffer : 0)
    offset
if htf3.settings.show and ValidTimeframe() and cnt < last
    htf3.Monitor().Update(offset)
    cnt := cnt + 1
    offset := offset + (cnt > 0 ? htf3.candles.size() * settings.width + (htf3.candles.size() > 0 ? (htf3.candles.size() - 1) * settings.buffer : 0) + settings.htf_buffer : 0)
    offset

// Draw Session Dividers (if enabled)
if show_session_divider and ValidTimeframe()
    DrawSessionDividers()

// Draw Fractal Dividers (if enabled)
if htf0.settings.show and show_divider and ValidTimeframe()
    drawFractalDivider(htf0.settings.show, htf0.settings.htf, fmDividers, htf0.settings.max_display)

// Draw Fractal Model (if enabled)
if htf0.settings.show and ValidTimeframe() and barstate.islast
    drawFractalModel(htf0.settings.show, htf0.candles)

// Show HTF Info
if show_htf_table and ValidTimeframe() and barstate.islast
    HTFInfoTable(htf1, htf2, htf3)
