//@version=6
indicator('Just C3', overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 5000)

type Candle
    float o
    float c
    float h
    float l
    int o_time
    int c_idx
    int h_idx
    int l_idx
    string dow
    box body
    line wick_up
    line wick_down
    label dow_label
    line swing_high_line
    line swing_low_line
    line ltf_swing_high_line
    line ltf_swing_low_line
    label ltf_swing_high_label
    label ltf_swing_low_label
    line eq_line
    line div_high_line
    line div_low_line

type CandleSettings
    bool show
    string htf
    int max_display

type Settings
    color bull_body
    color bear_body
    color border
    int offset
    int buffer
    int htf_buffer
    int width
    bool candle_time
    string label_position
    string label_alignment
    bool htf_label_show
    color htf_label_color
    string htf_label_size
    color dow_color
    string dow_size

type CandleSet
    array<Candle> candles
    CandleSettings settings
    label tfNameTop
    label tfNameBottom

Settings settings = Settings.new()

