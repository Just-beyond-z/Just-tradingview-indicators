color color_transparent = #ffffff00
var line[] session_vertical_lines = array.new_line()
var label[] session_vertical_labels = array.new_label()

table_position_value = table_position == "Middle Right" ? position.middle_right : table_position == "Top Right" ? position.top_right : position.bottom_right

type dwm_hl
    array<line> hi_line
    array<line> lo_line
    array<line> eq_line
    array<label> hi_label
    array<label> lo_label
    array<bool> hit_high
    array<bool> hit_low
    array<int> hit_high_time
    array<int> hit_low_time

type dwm_info
    string tf
    float o = na
    float h = na
    float l = na
    float ph = na
    float pl = na
    int h_time = na
    int l_time = na
    int ph_time = na
    int pl_time = na

type hz
    array<line> LN
    array<label> LB
    array<bool> CO

type lines_helper
    hz _hz
    string h
    string h_text
    color h_color

var d_hl = dwm_hl.new(array.new_line(), array.new_line(), array.new_line(), array.new_label(), array.new_label(), array.new_bool(), array.new_bool(), array.new_int(), array.new_int())
var w_hl = dwm_hl.new(array.new_line(), array.new_line(), array.new_line(), array.new_label(), array.new_label(), array.new_bool(), array.new_bool(), array.new_int(), array.new_int())
var m_hl = dwm_hl.new(array.new_line(), array.new_line(), array.new_line(), array.new_label(), array.new_label(), array.new_bool(), array.new_bool(), array.new_int(), array.new_int())

var d_info = dwm_info.new("D")
var w_info = dwm_info.new("W")
var m_info = dwm_info.new("M")

update_dwm_info(dwm_info n) =>
    if na(n.h_time)
        n.h := high
        n.l := low
        n.h_time := time
        n.l_time := time
    else if timeframe.change(n.tf)
        n.ph := n.h
        n.pl := n.l
        n.ph_time := n.h_time
        n.pl_time := n.l_time

        n.h := high
        n.l := low
        n.h_time := time
        n.l_time := time
    else
        if high > n.h
            n.h := high
            n.h_time := time

        if low < n.l
            n.l := low
            n.l_time := time

if dhl
    update_dwm_info(d_info)
if whl
    update_dwm_info(w_info)
if mhl
    update_dwm_info(m_info)

dwm_hl(string tf, bool use, dwm_hl hl, dwm_info n, color col) =>
    if use
        int prev_period_time = ta.valuewhen(timeframe.change(tf), time, 1)
        int future_time = time + (not na(time[1]) ? time - time[1] : timeframe.in_seconds() * 1000) * 3

        // Create new previous-period levels
        if timeframe.change(tf)
            float eq_level = (n.ph + n.pl) / 2

            hl.hi_line.unshift(line.new(n.ph_time, n.ph, time, n.ph, xloc = xloc.bar_time, style = line.style_solid, width = 1, color = col))
            hl.lo_line.unshift(line.new(n.pl_time, n.pl, time, n.pl, xloc = xloc.bar_time, style = line.style_solid, width = 1, color = col))
            hl.eq_line.unshift(line.new(prev_period_time, eq_level, time, eq_level, xloc = xloc.bar_time, style = line.style_dashed, width = 1, color = col))

            hl.hi_label.unshift(label.new(time, n.ph, "", xloc = xloc.bar_time, style = label.style_label_left, color = color_transparent, textcolor = col, size = size.tiny))
            hl.lo_label.unshift(label.new(time, n.pl, "", xloc = xloc.bar_time, style = label.style_label_left, color = color_transparent, textcolor = col, size = size.tiny))

            // Add hit state for the new level
            hl.hit_high.unshift(false)
            hl.hit_low.unshift(false)
            hl.hit_high_time.unshift(na)
            hl.hit_low_time.unshift(na)

            if hl.hi_line.size() > 1
                hl.hi_line.pop().delete()
                hl.lo_line.pop().delete()
                hl.eq_line.pop().delete()
                hl.hi_label.pop().delete()
                hl.lo_label.pop().delete()

                hl.hit_high.pop()
                hl.hit_low.pop()
                hl.hit_high_time.pop()
                hl.hit_low_time.pop()

        // Process all previous-period levels
        if hl.hi_line.size() > 0
            for i = 0 to hl.hi_line.size() - 1

                float hi_level = hl.hi_line.get(i).get_y1()
                float lo_level = hl.lo_line.get(i).get_y1()
                float eq_level = (hi_level + lo_level) / 2

                bool already_hit_high = hl.hit_high.get(i)
                bool already_hit_low = hl.hit_low.get(i)

                // Check if THIS specific high was touched
                if not already_hit_high and high >= hi_level
                    hl.hit_high.set(i, true)
                    hl.hit_high_time.set(i, time)

                // Check if THIS specific low was touched
                if not already_hit_low and low <= lo_level
                    hl.hit_low.set(i, true)
                    hl.hit_low_time.set(i, time)

                int label_left_offset = timeframe.in_seconds() * 1000 * 4

                bool high_hit = hl.hit_high.get(i)
                int hi_x2 = future_time
                hl.hi_line.get(i).set_x2(hi_x2)

                bool low_hit = hl.hit_low.get(i)
                int lo_x2 = future_time
                hl.lo_line.get(i).set_x2(lo_x2)

                hl.eq_line.get(i).set_x2(future_time)

                int hi_label_x = hi_x2
                int lo_label_x = lo_x2

                string period_name = "P" + tf + str.tostring(i + 1)

                hl.hi_label.get(i).set_text(period_name + " H")
                hl.lo_label.get(i).set_text(period_name + " L")
                hl.hi_label.get(i).set_x(hi_label_x)
                hl.hi_label.get(i).set_y(hi_level)
                hl.lo_label.get(i).set_x(lo_label_x)
                hl.lo_label.get(i).set_y(lo_level)

                if high_hit
                    hl.hi_line.get(i).set_style(line.style_solid)

                if low_hit
                    hl.lo_line.get(i).set_style(line.style_solid)
dwm() =>
    dwm_hl("D", dhl, d_hl, d_info, d_color)
    dwm_hl("W", whl, w_hl, w_info, w_color)
    dwm_hl("M", mhl, m_hl, m_info, m_color)

//+------------------------------------------------------------------------------------------------------------+//
//+--- Internal Functions                                                                                   ---+//
//+------------------------------------------------------------------------------------------------------------+//
ValidTimeframe(tfType, tf_limit) =>
    if tfType == 'HTF' and timeframe.in_seconds() < timeframe.in_seconds(tf_limit)
        true
    else if tfType == 'LTF' and timeframe.in_seconds() <= timeframe.in_seconds(tf_limit)
        true
    else
        false

DayofWeek(int index) =>
    switch index
        1 => 'M'
        2 => 'T'
        3 => 'W'
        4 => 'T'
        5 => 'F'
        6 => 'S'
        7 => 'S'
        => ''

get_line_style(style) =>
    switch style
        '------' => line.style_dashed
        '······' => line.style_dotted
        => line.style_solid

HTFName(string HTF) =>
    formatted = HTF

    seconds = timeframe.in_seconds(HTF)
    if seconds < 60
        formatted := str.tostring(seconds) + 's'
        formatted
    else if seconds / 60 < 60
        formatted := str.tostring(seconds / 60) + 'm'
        formatted
    else if seconds / 60 / 60 < 24
        formatted := str.tostring(seconds / 60 / 60) + 'H'
        formatted
    formatted

HTFEnabled() =>
    int enabled = 0
    enabled += htf1.settings.show ? 1 : 0
    enabled += htf2.settings.show ? 1 : 0
    enabled += htf3.settings.show ? 1 : 0
    enabled

CandleSetHigh(array<Candle> candles, float h) =>
    float _h = h
    if array.size(candles) > 0
        for i = 0 to array.size(candles) - 1 by 1
            Candle c = array.get(candles, i)
            if c.h > _h
                _h := c.h
                _h
    _h

CandleSetLow(array<Candle> candles, float l) =>
    float _l = l
    if array.size(candles) > 0
        for i = 0 to array.size(candles) - 1 by 1
            Candle c = array.get(candles, i)
            if c.l < _l
                _l := c.l
                _l
    _l

CandlesHigh(array<Candle> candles) =>
    h = 0.0
    int cnt = 0
    int last = HTFEnabled()

    if ValidTimeframe('HTF', htf1.settings.htf)
        h := CandleSetHigh(htf1.candles, h)
        cnt := cnt + 1
    if ValidTimeframe('HTF', htf2.settings.htf) and cnt < last
        h := CandleSetHigh(htf2.candles, h)
        cnt := cnt + 1
    if ValidTimeframe('HTF', htf3.settings.htf) and cnt < last
        h := CandleSetHigh(htf3.candles, h)
        cnt := cnt + 1
    if array.size(candles) > 0
        for i = 0 to array.size(candles) - 1 by 1
            Candle c = array.get(candles, i)
            if c.h > h
                h := c.h
    h

CandlesLow(array<Candle> candles, float h) =>
    l = h
    int cnt = 0
    int last = HTFEnabled()

    if ValidTimeframe('HTF', htf1.settings.htf)
        l := CandleSetLow(htf1.candles, l)
        cnt := cnt + 1
    if ValidTimeframe('HTF', htf2.settings.htf) and cnt < last
        l := CandleSetLow(htf2.candles, l)
        cnt := cnt + 1
    if ValidTimeframe('HTF', htf3.settings.htf) and cnt < last
        l := CandleSetLow(htf3.candles, l)
        cnt := cnt + 1
    if array.size(candles) > 0
        for i = 0 to array.size(candles) - 1 by 1
            Candle c = array.get(candles, i)
            if c.l < l
                l := c.l
    l

method Reorder(CandleSet candleSet, int offset) =>
    size = candleSet.candles.size()

    if size > 0
        for i = size - 1 to 0 by 1
            Candle candle = candleSet.candles.get(i)
            t_buffer = offset + (settings.width + settings.buffer) * (size - i - 1)
            box.set_left(candle.body, bar_index + t_buffer)
            box.set_right(candle.body, bar_index + settings.width + t_buffer)
            line.set_x1(candle.wick_up, bar_index + settings.width / 2 + t_buffer)
            line.set_x2(candle.wick_up, bar_index + settings.width / 2 + t_buffer)
            line.set_x1(candle.wick_down, bar_index + settings.width / 2 + t_buffer)
            line.set_x2(candle.wick_down, bar_index + settings.width / 2 + t_buffer)

            if settings.candle_time == true and (candleSet.settings.htf == '240' or candleSet.settings.htf == '420' or candleSet.settings.htf == 'D')
                if not na(candle.dow_label)
                    candle.dow_label.set_y(candle.l)
                    candle.dow_label.set_x(bar_index + settings.width / 2 + t_buffer)
                    candle.dow_label.set_text(candle.dow)
                else
                    candle.dow_label := label.new(bar_index + settings.width / 2 + t_buffer, candle.l, candle.dow, color = color_transparent, textcolor = settings.dow_color, style = label.style_label_up, size = settings.dow_size, text_font_family = font.family_monospace)
            
            // Check if NEXT candle creates a swing on THIS candle (for drawing swing lines)
            // Include all candles except index 0 (most recent)
            if (show_sweep_lines or show_expansion_lines) and i >= 1
                Candle next_candle = candleSet.candles.get(i - 1)
                // High line Logic
                bool is_potential_high_sweep     = i == 1 and next_candle.h > candle.h
                bool is_confirmed_high_sweep     = i > 1 and next_candle.h > candle.h and next_candle.c < candle.h
                bool is_confirmed_high_expansion = i > 1 and next_candle.h > candle.h and next_candle.c > candle.h
                // Low line Logic
                bool is_potential_low_sweep      = i == 1 and next_candle.l < candle.l
                bool is_confirmed_low_sweep      = i > 1 and next_candle.l < candle.l and next_candle.c > candle.l
                bool is_confirmed_low_expansion  = i > 1 and next_candle.l < candle.l and next_candle.c < candle.l

                // Swing high line (show both potential and confirmed)
                if is_potential_high_sweep or is_confirmed_high_sweep
                    int next_buffer = offset + (settings.width + settings.buffer) * (size - (i - 1) - 1)
                    int line_start = bar_index + settings.width / 2 + t_buffer
                    int line_end = bar_index + next_buffer
                    string line_style = is_potential_high_sweep ? ltf_c2_line_style: ltf_c3_line_style
                    color swing_line_color = is_potential_high_sweep ? sweep_c2_line_color : sweep_c3_line_color
                    swing_line_color := next_candle.c < candle.h ? (show_sweep_lines ? swing_line_color : color_transparent) : (show_expansion_lines ? expansion_line_color : color_transparent)
                    bool show_ltf_line = is_potential_high_sweep ? show_ltf_c2_line : show_ltf_c3_line
                    if (candleSet.settings.htf == '240' or candleSet.settings.htf == '420') and show_ltf_line and ValidTimeframe('LTF', ltf_limit)
                        if na(candle.ltf_swing_high_line)
                            candle.ltf_swing_high_line := line.new(
                                candle.h_idx, candle.h,
                                next_candle.c_idx, candle.h,
                                xloc=xloc.bar_index,
                                color=swing_line_color,
                                style=get_line_style(line_style),
                                width=sweep_line_width) 
                        else
                            line.set_x1(candle.ltf_swing_high_line, candle.h_idx)
                            line.set_y1(candle.ltf_swing_high_line, candle.h)
                            line.set_x2(candle.ltf_swing_high_line, next_candle.c_idx)
                            line.set_y2(candle.ltf_swing_high_line, candle.h)
                            line.set_color(candle.ltf_swing_high_line, swing_line_color)
                            line.set_style(candle.ltf_swing_high_line, get_line_style(line_style))
                        // LTF swing high label
                        if na(candle.ltf_swing_high_label) and is_confirmed_high_sweep
                            candle.ltf_swing_high_label := label.new(
                                next_candle.c_idx,
                                candle.h,
                                HTFName(candleSet.settings.htf),
                                xloc=xloc.bar_index,
                                style=label.style_label_down,
                                color=color_transparent,
                                textcolor=swing_line_color,
                                size=size.tiny)
                        else
                            label.set_x(candle.ltf_swing_high_label, next_candle.c_idx)
                            label.set_y(candle.ltf_swing_high_label, candle.h)
                            label.set_color(candle.ltf_swing_high_label, color_transparent)
                            label.set_textcolor(candle.ltf_swing_high_label, swing_line_color)
                            label.set_style(candle.ltf_swing_high_label, label.style_label_down)

                    if na(candle.swing_high_line)
                        candle.swing_high_line := line.new(line_start, candle.h, line_end, candle.h, color=swing_line_color, width=1, style=get_line_style(line_style))
                    else
                        line.set_x1(candle.swing_high_line, line_start)
                        line.set_y1(candle.swing_high_line, candle.h)
                        line.set_x2(candle.swing_high_line, line_end)
                        line.set_y2(candle.swing_high_line, candle.h)
                        line.set_color(candle.swing_high_line, swing_line_color)
                        line.set_style(candle.swing_high_line, get_line_style(line_style))
                else
                    // Delete only if confirmed closed candle invalidated the swing
                    if i > 1 and not na(candle.swing_high_line)
                        line.delete(candle.swing_high_line)
                        candle.swing_high_line := na
                    if i > 1 and not na(candle.ltf_swing_high_line)
                        line.delete(candle.ltf_swing_high_line)
                        candle.ltf_swing_high_line := na
                    if i > 1 and not na(candle.ltf_swing_high_label)
                        label.delete(candle.ltf_swing_high_label)
                        candle.ltf_swing_high_label := na

                // Swing low line (show both potential and confirmed)
                if is_potential_low_sweep or is_confirmed_low_sweep
                    int next_buffer = offset + (settings.width + settings.buffer) * (size - (i - 1) - 1)
                    int line_start = bar_index + settings.width / 2 + t_buffer
                    int line_end = bar_index + next_buffer
                    string line_style = is_potential_low_sweep ? ltf_c2_line_style : ltf_c3_line_style
                    color swing_line_color = is_potential_low_sweep ? sweep_c2_line_color : sweep_c3_line_color
                    swing_line_color := next_candle.c > candle.l ? (show_sweep_lines ? swing_line_color : color_transparent) : (show_expansion_lines ? expansion_line_color : color_transparent)
                    bool show_ltf_line = is_potential_low_sweep ? show_ltf_c2_line : show_ltf_c3_line
                    if (candleSet.settings.htf == '240' or candleSet.settings.htf == '420') and show_ltf_line and ValidTimeframe('LTF', ltf_limit)
                        if na(candle.ltf_swing_low_line)
                            candle.ltf_swing_low_line := line.new(
                                candle.l_idx, candle.l,
                                next_candle.c_idx, candle.l,
                                xloc=xloc.bar_index,
                                color=swing_line_color,
                                style=get_line_style(line_style),
                                width=sweep_line_width)
                        else 
                            line.set_x1(candle.ltf_swing_low_line, candle.l_idx)
                            line.set_y1(candle.ltf_swing_low_line, candle.l)
                            line.set_x2(candle.ltf_swing_low_line, next_candle.c_idx)
                            line.set_y2(candle.ltf_swing_low_line, candle.l)
                            line.set_color(candle.ltf_swing_low_line, swing_line_color)
                            line.set_style(candle.ltf_swing_low_line, get_line_style(line_style))
                        // LTF swing low label
                        if na(candle.ltf_swing_low_label) and is_confirmed_low_sweep
                            candle.ltf_swing_low_label := label.new(
                                next_candle.c_idx,
                                candle.l,
                                HTFName(candleSet.settings.htf),
                                xloc=xloc.bar_index,
                                style=label.style_label_up,
                                color=color_transparent,
                                textcolor=swing_line_color,
                                size=size.tiny)
                        else
                            label.set_x(candle.ltf_swing_low_label, next_candle.c_idx)
                            label.set_y(candle.ltf_swing_low_label, candle.l)
                            label.set_color(candle.ltf_swing_low_label, color_transparent)
                            label.set_textcolor(candle.ltf_swing_low_label, swing_line_color)
                            label.set_style(candle.ltf_swing_low_label, label.style_label_up)

                    if na(candle.swing_low_line)
                        candle.swing_low_line := line.new(line_start, candle.l, line_end, candle.l, color=swing_line_color, width=1, style=get_line_style(line_style))
                    else
                        line.set_x1(candle.swing_low_line, line_start)
                        line.set_y1(candle.swing_low_line, candle.l)
                        line.set_x2(candle.swing_low_line, line_end)
                        line.set_y2(candle.swing_low_line, candle.l)
                        line.set_color(candle.swing_low_line, swing_line_color)
                        line.set_style(candle.swing_low_line, get_line_style(line_style))
                else
                    // Delete only if confirmed closed candle invalidated the swing
                    if i > 1 and not na(candle.swing_low_line)
                        line.delete(candle.swing_low_line)
                        candle.swing_low_line := na
                    if i > 1 and not na(candle.ltf_swing_low_line)
                        line.delete(candle.ltf_swing_low_line)
                        candle.ltf_swing_low_line := na
                    if i > 1 and not na(candle.ltf_swing_low_label)
                        label.delete(candle.ltf_swing_low_label)
                        candle.ltf_swing_low_label := na

            // Draw EQ line from each closed candle to the next candle
            if show_eq_line and  i == 1 and size >= 2
                // This candle's equilibrium (midpoint of high and low)
                float eq_price = (candle.h + candle.l) / 2
                
                // Line from right edge of this candle to left edge of next candle (toward index 0)
                int next_buffer = offset + (settings.width + settings.buffer) * (size - (i - 1) - 1)
                int line_start_x = bar_index + settings.width + t_buffer
                int line_end_x = bar_index + next_buffer + 2
                
                if na(candle.eq_line)
                    candle.eq_line := line.new(line_start_x, eq_price, line_end_x, eq_price, color=eq_line_color, width=1, style=get_line_style(eq_line_style))
                else
                    line.set_x1(candle.eq_line, line_start_x)
                    line.set_y1(candle.eq_line, eq_price)
                    line.set_x2(candle.eq_line, line_end_x)
                    line.set_y2(candle.eq_line, eq_price)
            else if show_eq_line and i > 1
                // Delete EQ line from older candles
                if not na(candle.eq_line)
                    line.delete(candle.eq_line)
                    candle.eq_line := na

    top = 0.0
    bottom = 0.0

    if settings.label_alignment == 'Align'
        top := CandlesHigh(candleSet.candles)
        bottom := CandlesLow(candleSet.candles, top)
    if settings.label_alignment == 'Follow Candles'
        top := CandleSetHigh(candleSet.candles, 0)
        bottom := CandleSetLow(candleSet.candles, top)

    left = bar_index + offset + (settings.width + settings.buffer) * (size - 1) / 2

    // Always update labels on last bar for visibility after resume
    if settings.htf_label_show and barstate.islast
        string lblt = HTFName(candleSet.settings.htf)
        
        string lbll = lblt
        if settings.candle_time
            lblt := lblt + '\n'

        if settings.label_position == 'Both' or settings.label_position == 'Top'
            
            if not na(candleSet.tfNameTop)
                candleSet.tfNameTop.set_xy(left, top)
                candleSet.tfNameTop.set_text(lblt)  // Update text to include swing icons
            else
                candleSet.tfNameTop := label.new(left, top, lblt, color = color_transparent, textcolor = settings.htf_label_color, style = label.style_label_down, size = settings.htf_label_size, text_font_family = font.family_monospace)
            
        if settings.label_position == 'Both' or settings.label_position == 'Bottom'
            if not na(candleSet.tfNameBottom)
                candleSet.tfNameBottom.set_xy(left, bottom)
                candleSet.tfNameBottom.set_text(lbll)  // Update text to include swing icons
            else
                candleSet.tfNameBottom := label.new(left, bottom, lbll, color = color_transparent, textcolor = settings.htf_label_color, style = label.style_label_up, size = settings.htf_label_size, text_font_family = font.family_monospace)
            
    candleSet

// Alerts for C3
AlertC3(CandleSet candleSet) => 
    size = candleSet.candles.size()
    allowAlert = not na(time(timeframe.period, "0000-1100"))
    if candleSet.settings.show and enable_alert_c3 and allowAlert and size >= 3
        Candle c1 = array.get(candleSet.candles, 2)
        Candle c2 = array.get(candleSet.candles, 1)
        Candle c3 = array.get(candleSet.candles, 0)
        bool highSweep = c2.h > c1.h and c2.c <= c1.h
        bool lowSweep  = c2.l < c1.l and c2.c >= c1.l

        string tf_name = HTFName(candleSet.settings.htf)
        if highSweep 
            alert(tf_name + " C3 ▼" )

        if lowSweep
            alert(tf_name + " C3 ▲")

method Monitor(CandleSet candleSet) =>
    HTFBarTime = time(candleSet.settings.htf, session_timezone)
    isNewHTFCandle = ta.change(HTFBarTime) > 0

    if isNewHTFCandle
        Candle candle = Candle.new()
        candle.o := open
        candle.c := close
        candle.h := high
        candle.l := low
        candle.o_time := time

        candle.c_idx := bar_index
        candle.h_idx := bar_index
        candle.l_idx := bar_index
        string candleHourNy = str.format_time(candle.o_time, 'HH', session_timezone)
        candle.dow := switch
            candleSet.settings.htf == 'D' => DayofWeek(dayofweek(time, session_timezone))
            candleSet.settings.htf == '420' => candleHourNy == '18' or candleHourNy == '17' ? 'A' : candleHourNy == '01' or candleHourNy == '00' ? 'L' : candleHourNy == '08' or candleHourNy == '07' ? 'N' : ''
            => candleHourNy

        bull = candle.c > candle.o

        candle.body := box.new(bar_index, math.max(candle.o, candle.c), bar_index + 2, math.min(candle.o, candle.c), bull ? settings.bull_border : settings.bear_border, 1, bgcolor = bull ? settings.bull_body : settings.bear_body)
        candle.wick_up := line.new(bar_index + 1, candle.h, bar_index, math.max(candle.o, candle.c), color = bull ? settings.bull_border : settings.bear_border)
        candle.wick_down := line.new(bar_index + 1, math.min(candle.o, candle.c), bar_index, candle.l, color = bull ? settings.bull_border : settings.bear_border)

        candleSet.candles.unshift(candle)

        if candleSet.candles.size() > candleSet.settings.max_display
            Candle delCandle = array.pop(candleSet.candles)
            box.delete(delCandle.body)
            line.delete(delCandle.wick_up)
            line.delete(delCandle.wick_down)
            if not na(delCandle.dow_label)
                label.delete(delCandle.dow_label)
            if not na(delCandle.swing_high_line)
                line.delete(delCandle.swing_high_line)
            if not na(delCandle.swing_low_line)
                line.delete(delCandle.swing_low_line)
            if not na(delCandle.ltf_swing_high_line)
                line.delete(delCandle.ltf_swing_high_line)
            if not na(delCandle.ltf_swing_low_line)
                line.delete(delCandle.ltf_swing_low_line)
            if not na(delCandle.ltf_swing_high_label)
                label.delete(delCandle.ltf_swing_high_label)
            if not na(delCandle.ltf_swing_low_label)
                label.delete(delCandle.ltf_swing_low_label)
            if not na(delCandle.eq_line)
                line.delete(delCandle.eq_line)

        // Alerts for C3
        AlertC3(candleSet)
    candleSet

method Update(CandleSet candleSet, int offset) =>
    if candleSet.candles.size() > 0
        Candle candle = candleSet.candles.first()
        candle.h_idx := high > candle.h ? bar_index : candle.h_idx
        candle.h := high > candle.h ? high : candle.h
        candle.l_idx := low < candle.l ? bar_index : candle.l_idx
        candle.l := low < candle.l ? low : candle.l
        candle.c := close
        candle.c_idx := bar_index

        bull = candle.c > candle.o

        box.set_top(candle.body, candle.o)
        box.set_bottom(candle.body, candle.c)
        box.set_bgcolor(candle.body, bull ? settings.bull_body : settings.bear_body)
        box.set_border_color(candle.body, bull ? settings.bull_border : settings.bear_border)
        line.set_color(candle.wick_up, bull ? settings.bull_border : settings.bear_border)
        line.set_color(candle.wick_down, bull ? settings.bull_border : settings.bear_border)
        line.set_y1(candle.wick_up, candle.h)
        line.set_y2(candle.wick_up, math.max(candle.o, candle.c))
        line.set_y1(candle.wick_down, candle.l)
        line.set_y2(candle.wick_down, math.min(candle.o, candle.c))

        // Always reorder candles to ensure visibility even after resume/refresh
        candleSet.Reorder(offset)
    candleSet

// Draws Session Dividers
DrawSessionDividers() =>
    [range_high, range_low] = request.security(syminfo.tickerid,"420",
         [math.max(high,high[1],high[2],high[3]),math.min(low,low[1],low[2],low[3])],
         barmerge.gaps_off,barmerge.lookahead_off)

    int h = hour(time, session_timezone)
    int m = minute(time, session_timezone)

    bool at_18 = h == 18 and m == 0
    bool at_02 = h == 1  and m == 0
    bool at_08 = h == 8  and m == 0

    bool session_open = at_18 or at_02 or at_08

    string session_long_name =
         at_18 ? "Asia" :
         at_02 ? "London" :
         at_08 ? "New York" : ""

    string session_short_name =
         at_18 ? "A" :
         at_02 ? "L" :
         at_08 ? "N" : ""

    string session_name =
         session_label == "Short" ? session_short_name :
         session_label == "Long"  ? session_long_name : ""

    if session_open and not na(range_high) and not na(range_low)
        line session_line = line.new(bar_index, range_high, bar_index, range_low, xloc=xloc.bar_index, extend=extend.none, color=session_line_color, width=1, style=get_line_style(session_line_style))
        label session_labl = label.new(bar_index, range_high, session_name, xloc=xloc.bar_index, style=label.style_label_down, color=color_transparent, textcolor=color.new(#000000, 40), size=session_label_size, text_font_family=font.family_monospace)

        array.push(session_vertical_lines, session_line)
        array.push(session_vertical_labels, session_labl)
    // UPDATE ALL EXISTING DIVIDERS
    if not na(range_high) and not na(range_low)
        int size = array.size(session_vertical_lines)
        if size > 0
            for i = 0 to size - 1
                line session_line = array.get(session_vertical_lines, i)
                label session_labl = array.get(session_vertical_labels, i)
                line.set_y1(session_line, range_high)
                line.set_y2(session_line, range_low)
                label.set_y(session_labl, range_high)
    // KEEP LAST 3
    while array.size(session_vertical_lines) > 3
        line.delete(array.shift(session_vertical_lines))
        label.delete(array.shift(session_vertical_labels))



// Draws HTF Info Table & ADR
int ADR_LENGTH = 20

float ADR = request.security(
     syminfo.tickerid,
     "D",
     ta.sma(high[1] - low[1], ADR_LENGTH),
     barmerge.gaps_off,
     barmerge.lookahead_off)

float today_range = request.security(
     syminfo.tickerid,
     "D",
     high - low,
     barmerge.gaps_off,
     barmerge.lookahead_off)

float ADR_percent = ADR > 0 ? today_range / ADR * 100 : na
HTFInfoTable(CandleSet htf1, CandleSet htf2, CandleSet htf3) =>
    // Active HTFs
    array<CandleSet> active_htfs = array.new<CandleSet>()
    if htf1.settings.show
        array.push(active_htfs, htf1)
    if htf2.settings.show
        array.push(active_htfs, htf2)
    if htf3.settings.show
        array.push(active_htfs, htf3)

    // Table dimensions
    int num_data_rows = 1
    if show_c3_row
        num_data_rows += 1
    int num_rows = num_data_rows + (show_timeframe_row ? 1 : 0)
    int num_cols = array.size(active_htfs) + 3

    var table htf_info_table = table.new(table_position_value, columns=num_cols, rows=num_rows, border_width=1, frame_width=1)

    // Table colors
    color header_bg = table_header_bg
    color header_text = table_header_text
    color label_bg = table_label_bg
    color label_text = table_label_text
    color data_bg = table_cell_bg
    color data_text = table_cell_text

    // Populate table
    if num_cols > 1 and num_rows > 0
        int row = 0

        // Header row
        if show_timeframe_row
            for col = 0 to array.size(active_htfs) - 1
                CandleSet htf = array.get(active_htfs, col)
                if htf.candles.size() >= 3
                    string tf_name = HTFName(htf.settings.htf)
                    table.cell(htf_info_table, col + 1, row, tf_name, bgcolor=header_bg, text_color=header_text, text_size=table_size, text_font_family=font.family_monospace)
            table.cell(htf_info_table, array.size(active_htfs) + 1, row, "ADR", bgcolor=header_bg, text_color=header_text, text_size=table_size, text_font_family=font.family_monospace)
            table.cell(htf_info_table, array.size(active_htfs) + 2, row, "ADR%", bgcolor=header_bg, text_color=header_text, text_size=table_size, text_font_family=font.family_monospace)
            row += 1

        // C3 row
        if show_c3_row
            for col = 0 to array.size(active_htfs) - 1
                CandleSet htf = array.get(active_htfs, col)
                if htf.candles.size() >= 3
                    string cell_text = na
                    color cell_bg = data_bg
                    Candle c1 = htf.candles.get(2)
                    Candle c2 = htf.candles.get(1)
                    Candle c3 = htf.candles.get(0)
                    bool confirmed_c2_high = c2.h > c1.h and c2.c <= c1.h
                    bool confirmed_c2_low = c2.l < c1.l and c2.c >= c1.l
                    if confirmed_c2_high and confirmed_c2_low
                        cell_text := c3.dow + " ▼▲ "
                        cell_bg := both_c3_color
                    else if confirmed_c2_high
                        cell_text := c3.dow + " ▼ "
                        cell_bg := bear_c3_color
                    else if confirmed_c2_low
                        cell_text := c3.dow + " ▲ "
                        cell_bg := bull_c3_color
                    table.cell(htf_info_table, col + 1, row, not na(cell_text) ? cell_text : " - ", bgcolor=cell_bg, text_color=data_text, text_size=table_size, text_font_family=font.family_monospace)
            if show_adr
                // ADR
                table.cell(htf_info_table, array.size(active_htfs) + 1, row, str.tostring(ADR, "#"), bgcolor=data_bg, text_color=data_text, text_size=table_size, text_font_family=font.family_monospace)

                // ADR%
                string adr_percent_text = not na(ADR_percent) ? str.tostring(ADR_percent, "#") + "%" : " - "
                table.cell(htf_info_table, array.size(active_htfs) + 2, row, adr_percent_text, bgcolor=data_bg, text_color=data_text, text_size=table_size, text_font_family=font.family_monospace)
//----------------------------- Main Calls --------------------------------- //

// Draw HTF Candles (if enabled)
int cnt = 0
int last = HTFEnabled()
int offset = settings.offset
if htf1.settings.show and ValidTimeframe('HTF', htf1.settings.htf) and cnt < last
    htf1.Monitor().Update(offset)
    cnt := cnt + 1
    offset := offset + (cnt > 0 ? htf1.candles.size() * settings.width + (htf1.candles.size() > 0 ? (htf1.candles.size() - 1) * settings.buffer : 0) + settings.htf_buffer : 0)
    offset
if htf2.settings.show and ValidTimeframe('HTF', htf2.settings.htf) and cnt < last
    htf2.Monitor().Update(offset)
    cnt := cnt + 1
    offset := offset + (cnt > 0 ? htf2.candles.size() * settings.width + (htf2.candles.size() > 0 ? (htf2.candles.size() - 1) * settings.buffer : 0) + settings.htf_buffer : 0)
    offset
if htf3.settings.show and ValidTimeframe('HTF', htf3.settings.htf) and cnt < last
    htf3.Monitor().Update(offset)
    cnt := cnt + 1
    offset := offset + (cnt > 0 ? htf3.candles.size() * settings.width + (htf3.candles.size() > 0 ? (htf3.candles.size() - 1) * settings.buffer : 0) + settings.htf_buffer : 0)
    offset


// Draw Session Dividers (if enabled)
if show_session_divider and ValidTimeframe('LTF', ltf_limit)
    DrawSessionDividers()

// Show Prev D/W/M levels
if showPrevLevels and ValidTimeframe('LTF', ltf_limit)  
    dwm()

// Show HTF Info
if show_htf_table and ValidTimeframe('LTF', ltf_limit) and barstate.islast
    HTFInfoTable(htf1, htf2, htf3)
